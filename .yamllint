---
# First-party YAML is linted repository-wide. What is ignored here is not
# first-party prose:
#   - agent skill manifests, which the skill installer owns and rewrites;
#   - the E2E sensor package, generated by `scripts/gen-e2e-sensors` from
#     `e2e/entity_coverage.py` — a fix applied here is undone by the next
#     generation, and its long lines are Jinja template expressions;
#   - the files Home Assistant writes for itself. They are tracked as empty
#     stubs so a fresh instance starts, and HA rewrites them from the UI.
ignore: |
  .agents/skills/*/agents/openai.yaml
  ha-dev/packages/e2e_simulated_sensors.yaml
  ha-dev/automations.yaml
  ha-dev/scenes.yaml
  ha-dev/scripts.yaml
  ha-test/automations.yaml
  ha-test/scenes.yaml
  ha-test/scripts.yaml

extends: default

rules:
  comments:
    level: error
    min-spaces-from-content: 2
  document-start:
    level: error
    present: true
  line-length:
    max: 120
  # YAML 1.1 treats `on` as a boolean. Keep GitHub Actions workflow keys quoted
  # so generic YAML tooling and GitHub agree on their meaning.
  truthy:
    allowed-values:
      - "true"
      - "false"
    check-keys: true
    level: error
