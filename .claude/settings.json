{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/ha:*)",
      "Bash(./scripts/check:*)",
      "Bash(./scripts/feature:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose config:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(curl -s http://localhost:8123/*)",
      "Bash(curl -s http://localhost:8124/*)"
    ],
    "deny": [
      "Read(./ha-dev/.storage/**)",
      "Read(./ha-dev/*.db*)",
      "Read(./.ha-token)",
      "Read(../lovelace-growspace-manager-card/dist/**)",
      "Read(../lovelace-growspace-manager-card/growspace-manager-card.js)",
      "Read(../lovelace-growspace-manager-card/**/*.map)",
      "Edit(../core/**)",
      "Write(../core/**)"
    ]
  }
}
