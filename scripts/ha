#!/usr/bin/env bash
# Control the Growspace Home Assistant dev/test runtimes.
#
#   ./scripts/ha dev  up|down|restart|logs|reload|shell|url|token|reset|mounts
#   ./scripts/ha test up|down|restart|logs|shell|url|reset
#
#   ./scripts/ha dev restart --main [backend|tc|card]...   back to the main checkouts
#   ./scripts/ha dev mounts [--porcelain]                   what each source mount serves
#
# "dev"  = localhost:8123, source bind-mounted live from the integrations + card
# "test" = localhost:8124, virgin config for HACS release verification
set -euo pipefail

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$WS"

INSTANCE="${1:-dev}"
CMD="${2:-}"

case "$INSTANCE" in
  dev)  SVC=ha-dev;  CTR=growspace-ha-dev;  PORT=8123; PROFILE=(); RUNTIME_SERVICES=(vision-dev) ;;
  test) SVC=ha-test; CTR=growspace-ha-test; PORT=8124; PROFILE=(--profile test); RUNTIME_SERVICES=() ;;
  *)    echo "usage: $0 {dev|test} <command>" >&2; exit 2 ;;
esac

dc() { docker compose "${PROFILE[@]}" "$@"; }

# The dev runtime's three source mounts, and what "the main checkout" means for
# each. Names are what `--main` and `mounts` accept.
MOUNTS=(backend tc card)

mount_var() {
  case "$1" in
    backend) echo GROWSPACE_BACKEND_SRC ;;
    tc)      echo GROWSPACE_TC_SRC ;;
    card)    echo GROWSPACE_CARD_DIST ;;
  esac
}

mount_target() {
  case "$1" in
    backend) echo /config/custom_components/growspace_manager ;;
    tc)      echo /config/custom_components/growspace_manager_tc ;;
    card)    echo /config/www/community/lovelace-growspace-manager-card ;;
  esac
}

# TC is an optional companion, so a hub whose sibling clone is absent — or is
# mid-rebase, or has not been pulled since the component landed — still has to
# start: its main mount is then an empty host-owned directory, rather than one
# Docker would invent as root from a path that does not exist.
tc_placeholder() {
  echo "$("$WS/scripts/growspace-repos" --hub)/ha-dev/custom_components/growspace_manager_tc"
}

main_source() {
  local repos="$WS/scripts/growspace-repos" main_tc
  case "$1" in
    backend) echo "$("$repos" growspace_manager)/custom_components/growspace_manager" ;;
    card)    echo "$("$repos" lovelace-growspace-manager-card)/dist" ;;
    tc)
      main_tc="$("$repos" growspace_manager_tc)/custom_components/growspace_manager_tc"
      if [ -d "$main_tc" ]; then echo "$main_tc"; else tc_placeholder; fi
      ;;
  esac
}

same_path() { [ "$(realpath -m -- "$1")" = "$(realpath -m -- "$2")" ]; }

# The TC placeholder counts as main too: it is what main means while the TC
# checkout is absent, and it must not be carried forward as an override once
# the checkout appears.
is_main_source() {
  same_path "$2" "$(main_source "$1")" && return 0
  [ "$1" = tc ] && same_path "$2" "$(tc_placeholder)"
}

# What the ha-dev container mounts right now, running or stopped. The container
# is the only record of it that cannot go stale: an override lives exactly as
# long as the container that was created with it, and nothing else remembers
# which session asked for it.
#
# Fills CONTAINER_STATE (empty when there is no container) and one
# CURRENT_<name> per source mount it carries.
read_current_mounts() {
  # Read back indirectly, as CURRENT_$name.
  # shellcheck disable=SC2034
  CONTAINER_STATE="" CURRENT_backend="" CURRENT_tc="" CURRENT_card=""
  [ "$INSTANCE" = dev ] || return 0
  command -v docker >/dev/null 2>&1 || return 0

  local inspected name target source
  # `{{...}}` below is docker's own Go template, not a shell expansion.
  # shellcheck disable=SC2016
  inspected="$(docker inspect --format \
    '{{.State.Status}}{{"\n"}}{{range .Mounts}}{{.Destination}}{{"\t"}}{{.Source}}{{"\n"}}{{end}}' \
    "$CTR" 2>/dev/null)" || return 0
  CONTAINER_STATE="$(head -1 <<<"$inspected")"
  while IFS=$'\t' read -r target source; do
    for name in "${MOUNTS[@]}"; do
      if [ "$target" = "$(mount_target "$name")" ]; then
        printf -v "CURRENT_$name" '%s' "$source"
      fi
    done
  done < <(tail -n +2 <<<"$inspected")
  return 0
}

# Decide every source mount before Compose sees the environment, in this order:
#
#   1. --main <name>   the main checkout, explicitly
#   2. GROWSPACE_*     the caller's own override
#   3. the container   whatever the current container mounts — so a restart that
#                      names only the card leaves another session's backend
#                      worktree alone, and a plain restart changes nothing
#   4. the main checkout
#
# Every mount ends up exported, so Compose, stamp-card-resource and the summary
# printed afterwards all read the same three paths.
resolve_mounts() {
  local name var current reset
  read_current_mounts

  for name in "${MOUNTS[@]}"; do
    var="$(mount_var "$name")"
    reset=0
    if [[ " ${RESET_MOUNTS[*]} " == *" $name "* ]]; then reset=1; fi

    if [ -n "${!var:-}" ]; then
      if [ "$reset" = 1 ]; then
        echo "ERROR: --main $name contradicts $var=${!var}; pass one or the other." >&2
        exit 2
      fi
      continue
    fi

    current="CURRENT_$name"
    current="${!current}"
    if [ "$reset" = 0 ] && [ -n "$current" ] && ! is_main_source "$name" "$current"; then
      if [ -e "$current" ]; then
        export "$var=$current"
        continue
      fi
      echo "   $name: the mounted $current no longer exists — back to the main checkout" >&2
    fi
    export "$var=$(main_source "$name")"
  done

  if [ ! -e "$GROWSPACE_TC_SRC" ] && same_path "$GROWSPACE_TC_SRC" "$(tc_placeholder)"; then
    mkdir -p "$GROWSPACE_TC_SRC"
  fi
}

print_mount() {
  local name="$1" source="$2" kind=override note=""
  if is_main_source "$name" "$source"; then kind=main; fi
  if [ ! -e "$source" ]; then note="  (missing)"; fi
  printf '  %-8s %-9s %s%s\n' "$name" "$kind" "$source" "$note"
}

# What resolve_mounts decided, printed after a start so every restart says what
# it kept. `./scripts/ha dev mounts` asks the container instead.
print_resolved_mounts() {
  [ "$INSTANCE" = dev ] || return 0
  local name var
  for name in "${MOUNTS[@]}"; do
    var="$(mount_var "$name")"
    print_mount "$name" "${!var}"
  done
}

show_mounts() {
  local porcelain="$1" name source kind
  read_current_mounts

  if [ "$porcelain" = 1 ]; then
    for name in "${MOUNTS[@]}"; do
      source="CURRENT_$name"
      source="${!source}"
      [ -n "$source" ] || continue
      kind=override
      if is_main_source "$name" "$source"; then kind=main; fi
      printf '%s\t%s\t%s\n' "$name" "$kind" "$source"
    done
    return 0
  fi

  if [ -z "$CONTAINER_STATE" ]; then
    echo "$CTR: no container — the next start mounts the main checkouts"
    return 0
  fi
  echo "$CTR ($CONTAINER_STATE)"
  for name in "${MOUNTS[@]}"; do
    source="CURRENT_$name"
    source="${!source}"
    if [ -n "$source" ]; then
      print_mount "$name" "$source"
    else
      printf '  %-8s %-9s %s\n' "$name" "-" "not mounted — the next restart mounts the main checkout"
    fi
  done
}

# The runtime belongs to the main hub checkout, never to a worktree of it.
#
# docker-compose.yml mounts ../growspace_manager, ../growspace_manager_tc and
# ../lovelace-growspace-manager-card *relative to the compose file*, and all
# checkouts produce the same Compose project and container names. Run this from
# a hub worktree and Compose does not start a second stack — it recreates the
# shared one with that worktree's siblings mounted instead. Those have no built
# dist/, so Docker silently creates an empty directory, HA serves 404 for the
# card, and every dashboard e2e spec fails with "card never visible".
#
# ha-dev/ (onboarding, tokens, the SQLite DB) lives beside the compose file too,
# so a worktree run would also point HA at an empty config.
require_main_checkout() {
  local main
  main="$("$WS/scripts/growspace-repos" --hub)"
  [ "$main" = "$(pwd -P)" ] && return 0   # also a hub that is no git checkout at all

  echo "ERROR: '$INSTANCE $CMD' must run from the main hub checkout, not a worktree." >&2
  echo "       here: $WS" >&2
  echo "       main: $main" >&2
  echo "       Running it here would repoint the shared :$PORT container at this" >&2
  echo "       worktree's siblings and its empty ha-$INSTANCE/ config." >&2
  echo >&2
  echo "       To serve worktree sources, run from the" >&2
  echo "       main checkout with the source overrides — ha-$INSTANCE/ stays correct:" >&2
  echo "         GROWSPACE_CARD_DIST=$("$WS/scripts/growspace-repos" lovelace-growspace-manager-card)/dist \\" >&2
  echo "         GROWSPACE_BACKEND_SRC=<worktree>/custom_components/growspace_manager \\" >&2
  echo "         GROWSPACE_TC_SRC=<tc-worktree>/custom_components/growspace_manager_tc \\" >&2
  echo "           $main/scripts/ha $INSTANCE restart" >&2
  exit 1
}

# `up` and `restart` take `--main [backend|tc|card]...`; bare `--main` is all three.
RESET_MOUNTS=()
PORCELAIN=0
parse_args() {
  local seen_main=0 arg
  for arg in "$@"; do
    case "$CMD:$arg" in
      up:--main|restart:--main) seen_main=1 ;;
      up:backend|up:tc|up:card|restart:backend|restart:tc|restart:card)
        [ "$seen_main" = 1 ] || { echo "ERROR: '$arg' only means something after --main" >&2; exit 2; }
        RESET_MOUNTS+=("$arg")
        ;;
      mounts:--porcelain) PORCELAIN=1 ;;
      *) echo "ERROR: '$INSTANCE $CMD' does not take '$arg'" >&2; exit 2 ;;
    esac
  done
  if [ "$seen_main" = 1 ] && [ "${#RESET_MOUNTS[@]}" = 0 ]; then
    RESET_MOUNTS=("${MOUNTS[@]}")
  fi
}

if [ "$INSTANCE" = dev ]; then
  parse_args "${@:3}"
elif [ "$#" -gt 2 ]; then
  echo "ERROR: '$INSTANCE $CMD' does not take '${3}'" >&2
  exit 2
fi

case "$CMD" in
  up|down|restart|reload|reset) require_main_checkout ;;
esac

case "$CMD" in
  up|restart) if [ "$INSTANCE" = dev ]; then resolve_mounts; fi ;;
  mounts)     ;;
  # Compose still interpolates the TC mount for every other command, so the
  # placeholder has to exist even when nothing is being started.
  *) [ "$INSTANCE" != dev ] || [ -d "$(main_source tc)" ] || mkdir -p "$(main_source tc)" ;;
esac

# Fail before Compose does, and before 'restart' has torn anything down.
#
# vision-dev is pull_policy: never on purpose — the dev loop runs the image you
# just built, not whatever a registry would hand back. So nothing fetches a tag
# that is missing: Compose aborts with a bare "No such image", which names
# neither the cause nor either fix. The cause is almost always a version bump —
# the default tag follows growspace_vision/config.yaml's `version`, so moving
# that line strands every previous local build (hit on 1.0.0 -> 1.0.1).
#
# 'restart' is why this is a preflight rather than a nicer error afterwards: it
# stops Vision and Home Assistant first, so Compose's failure lands with :$PORT
# already down.
#
# Compose resolves the tag rather than this script reproducing it, so the
# default and GROWSPACE_VISION_IMAGE stay in docker-compose.yml alone. An image
# we cannot resolve is a silent no-op: a preflight must not become the reason a
# start fails.
require_runtime_images() {
  [ "$INSTANCE" = dev ] || return 0
  command -v docker >/dev/null 2>&1 || return 0

  local image version present tag
  image="$(dc config --images vision-dev 2>/dev/null | head -1 || true)"
  [ -n "$image" ] || return 0
  docker image inspect "$image" >/dev/null 2>&1 && return 0

  echo "ERROR: the Growspace Vision App image '$image' is not on this machine." >&2
  echo "       vision-dev is pull_policy: never, so nothing will fetch it." >&2
  echo >&2
  echo "       The tag follows growspace_vision/config.yaml's version, so a bump" >&2
  echo "       leaves the previous local build behind. Rebuild it:" >&2
  echo "         ./scripts/vision build" >&2
  echo >&2
  version="${image#growspace-vision:}"
  version="${version%-amd64}"
  version="${version%-arm64}"
  echo "       Or run the published App image — what a user actually gets:" >&2
  echo "         GROWSPACE_VISION_IMAGE=ghcr.io/venosta-web/growspace-manager-vision:$version \\" >&2
  echo "           ./scripts/ha $INSTANCE $CMD" >&2
  # `{{.Repository}}` below is docker's own Go template, not a shell expansion.
  present="$(docker image ls growspace-vision --format '{{.Repository}}:{{.Tag}}' 2>/dev/null || true)"
  if [ -n "$present" ]; then
    echo >&2
    echo "       Built here already:" >&2
    while IFS= read -r tag; do
      echo "         $tag" >&2
    done <<<"$present"
  fi
  exit 1
}

case "$CMD" in
  up|restart) require_runtime_images ;;
esac

# Cache-bust the dev instance's Lovelace resources before HA reads them.
#
# The card's entry URL never changes shape, and HA serves /local/ with
# max-age=2678400 behind a service worker Ctrl+Shift+R does not bypass — so a
# rebuild lands on disk, is served correctly, and stays invisible in the browser.
# Stamping the registered URL with the bundle's content hash makes the two cache
# layers miss together. See scripts/stamp-card-resource.cjs.
#
# Callers must have the container STOPPED: a running HA holds lovelace_resources
# in memory and could write its own copy back over ours on shutdown.
#
# Only 'dev' needs this. The test instance installs through HACS, which appends
# its own ?hacstag=<version>.
stamp_card_resource() {
  [ "$INSTANCE" = dev ] || return 0
  if ! command -v node >/dev/null 2>&1; then
    echo "   stamp: no node — skipping the card cache-bust" >&2
    return 0
  fi
  node "$WS/scripts/stamp-card-resource.cjs" "$SVC"
}

prepare_runtime_services() {
  [ "$INSTANCE" = dev ] || return 0
  "$WS/scripts/vision" prepare
}

case "$CMD" in
  up)
    # Fail early and loudly if something else already owns the port —
    # this is exactly how the HA Core devcontainer used to silently win.
    # `{{.Names}}` below is docker's own Go template, not a shell expansion;
    # single quotes are what keep the shell out of it.
    # shellcheck disable=SC2016
    if ss -ltn "sport = :$PORT" 2>/dev/null | grep -q ":$PORT"; then
      owner="$(docker ps --format '{{.Names}}\t{{.Ports}}' | grep ":$PORT->" | cut -f1 || true)"
      echo "ERROR: port $PORT is already in use${owner:+ by container '$owner'}." >&2
      echo "       Free it first (e.g. docker stop $owner) then re-run." >&2
      exit 1
    fi
    prepare_runtime_services
    stamp_card_resource
    dc up -d "$SVC"
    echo "→ $INSTANCE starting at http://localhost:$PORT"
    echo "  config on host: $WS/ha-$INSTANCE"
    print_resolved_mounts
    ;;
  down)     dc stop "$SVC" "${RUNTIME_SERVICES[@]}" ;;
  restart)
    # Stop first, so the resource stamp lands in a .storage no running HA is
    # holding open. `up --force-recreate` would stop it anyway; making that
    # explicit is what buys the ordering.
    dc stop "$SVC" "${RUNTIME_SERVICES[@]}" 2>/dev/null || true
    prepare_runtime_services
    stamp_card_resource
    # Recreate rather than merely restarting so bind mounts resolve the current
    # host path/inode. Rollup deletes and recreates the card's dist/ directory.
    dc up -d --force-recreate "$SVC" "${RUNTIME_SERVICES[@]}"
    echo "→ recreated $CTR"
    print_resolved_mounts
    ;;
  mounts)
    [ "$INSTANCE" = dev ] || { echo "'$INSTANCE' has no source mounts" >&2; exit 2; }
    show_mounts "$PORCELAIN"
    ;;
  logs)     docker logs -f --tail 200 "$CTR" ;;
  shell)    docker exec -it "$CTR" bash ;;
  url)      echo "http://localhost:$PORT" ;;

  reload)
    # Reload just our integration without a full HA restart.
    # Looks up the real config entry id via the REST API, then reloads it.
    if [ ! -f "$WS/.ha-token" ]; then
      echo "No token yet. Run: ./scripts/ha $INSTANCE token" >&2; exit 1
    fi
    TOKEN="$(cat "$WS/.ha-token")"
    API="http://localhost:$PORT/api"

    ENTRY_IDS=$(curl -sf -H "Authorization: Bearer $TOKEN" \
      "$API/config/config_entries/entry" 2>/dev/null \
      | python3 -c "import sys,json;print(' '.join(e['entry_id'] for e in json.load(sys.stdin) if e.get('domain')=='growspace_manager'))" 2>/dev/null || true)

    if [ -z "${ENTRY_IDS// /}" ]; then
      echo "No growspace_manager config entry found (not set up yet, or token lacks admin)."
      echo "Falling back to a full container restart."
      dc restart "$SVC"
      exit 0
    fi

    rc=0
    for id in $ENTRY_IDS; do
      code=$(curl -s -o /dev/null -w '%{http_code}' -X POST \
        "$API/config/config_entries/entry/$id/reload" \
        -H "Authorization: Bearer $TOKEN")
      if [ "$code" = "200" ]; then
        echo "→ reloaded config entry $id"
      else
        echo "→ reload of $id returned HTTP $code" >&2; rc=1
      fi
    done
    if [ $rc -ne 0 ]; then
      echo "Reload failed; falling back to container restart." >&2
      dc restart "$SVC"
    fi
    ;;

  token)
    echo "Create a long-lived token in HA:"
    echo "  1. open http://localhost:$PORT/profile/security"
    echo "  2. bottom of page → 'Create token'"
    echo "  3. paste it here:"
    read -r -s tok
    printf '%s' "$tok" > "$WS/.ha-token"
    chmod 600 "$WS/.ha-token"
    echo "saved → $WS/.ha-token (git-ignored)"
    ;;

  reset)
    # Nuke instance state but keep configuration.yaml and friends.
    read -r -p "Delete .storage/, DB and logs for '$INSTANCE'? [y/N] " ans
    [ "$ans" = "y" ] || { echo "aborted"; exit 0; }
    dc stop "$SVC" "${RUNTIME_SERVICES[@]}" 2>/dev/null || true
    rm -rf "$WS/ha-$INSTANCE/.storage" \
           "$WS/ha-$INSTANCE"/home-assistant*.db* \
           "$WS/ha-$INSTANCE"/home-assistant.log*
    [ "$INSTANCE" != dev ] || "$WS/scripts/vision" reset
    echo "→ '$INSTANCE' reset to a fresh onboarding state"
    ;;

  *)
    sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
    exit 2 ;;
esac
