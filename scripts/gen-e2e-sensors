#!/usr/bin/env python3
"""
Generate simulated sensors for the e2e growspaces.

Every sensor the e2e suite wires (see tests/e2e/fixtures/e2e-setup.ts
`buildSensors`) gets a deterministic, time-driven waveform so dashboards and
specs see plausible, continuously-changing data without any hardware.

  ./scripts/gen-e2e-sensors            # write the package
  ./scripts/ha dev restart             # load it

Output: ha-dev/packages/e2e_simulated_sensors.yaml  (regenerate, never hand-edit)

Design
------
* Stage growspaces (veg, clone, ...) use trigger-based `template` sensors that
  recompute every 30s from `now()`. Pure function of time -> reproducible.
* VWC growspaces use `input_number` helpers, because the e2e specs set those
  directly via `input_number.set_value`. Simulating them would fight the tests,
  so they are created with sane starting values and left alone.
* Waveforms are sine over a per-signal period, with a per-growspace phase offset
  so the spaces do not move in lockstep. `energy` is a monotonic ramp instead —
  it is a `total_increasing` meter and must never go down.
* Irrigation and drain pumps are `switch.sim_e2e_<slug>_*`, which is the entity
  id `e2e-setup.ts` wires. They are template switches backed by input_booleans,
  so the specs can actually toggle them and the state persists.
"""
import pathlib, sys

STAGE_SLUGS = ["veg", "clone", "mother", "flower", "dry", "cure"]
VWC_SLUGS = ["vwc_veg", "vwc_flower"]

# suffix -> (unit, device_class, state_class, low, high, period_s)
SIGNALS = {
    "temperature":           ("°C",     "temperature",   "measurement", 20.0, 28.0, 3600),
    "humidity":              ("%",      "humidity",      "measurement", 45.0, 70.0, 5400),
    "vpd":                   ("kPa",    None,            "measurement", 0.8,  1.4,  3600),
    "co2":                   ("ppm",    "carbon_dioxide","measurement", 400,  1200, 1800),
    "feed_ec":               ("mS/cm",  None,            "measurement", 1.6,  2.4,  7200),
    "bulk_ec":               ("mS/cm",  None,            "measurement", 1.0,  3.0,  7200),
    "pore_ec":               ("mS/cm",  None,            "measurement", 1.2,  3.4,  7200),
    "runoff_ec":             ("mS/cm",  None,            "measurement", 1.4,  3.0,  7200),
    "ph":                    ("pH",     None,            "measurement", 5.6,  6.4,  9000),
    "substrate_temperature": ("°C",     "temperature",   "measurement", 18.0, 24.0, 5400),
    "substrate_moisture":    ("%",      "moisture",      "measurement", 35.0, 70.0, 2700),
    "power":                 ("W",      "power",         "measurement", 40.0, 600.0, 3600),
    "drain_volume":          ("L",      "volume",        "measurement", 0.0,  5.0,  1800),
    "irrigation_flow":       ("L/min",  None,            "measurement", 0.0,  2.0,  900),
    "irrigation_tank":       ("L",      None,            "measurement", 8.0,  50.0, 10800),
}

def sine_state(low, high, period, phase):
    """Jinja expression: sine between low and high, offset by `phase` seconds."""
    mid, amp = (high + low) / 2, (high - low) / 2
    dec = 0 if isinstance(low, int) and isinstance(high, int) else 2
    return (
        "{{ (%s + %s * sin( ((as_timestamp(now()) + %d) %% %d) / %d * 2 * pi )) "
        "| round(%d) }}" % (mid, amp, phase, period, period, dec)
    )

def main() -> int:
    out = [
        "# GENERATED by scripts/gen-e2e-sensors — do not edit by hand.",
        "# Simulated sensors backing the e2e growspaces.",
        "",
        "template:",
    ]
    for i, slug in enumerate(STAGE_SLUGS):
        phase = i * 600  # 10 min apart, so the spaces are visibly out of step
        out += [
            "  # ---------------------------------------------------------------",
            f"  # e2e_{slug}",
            "  # ---------------------------------------------------------------",
            "  - trigger:",
            "      - platform: time_pattern",
            '        seconds: "/30"',
            "    sensor:",
        ]
        for suffix, (unit, dev_cls, state_cls, low, high, period) in SIGNALS.items():
            out += [
                f"      - name: e2e {slug} {suffix}",
                f"        unique_id: e2e_{slug}_{suffix}",
                f'        unit_of_measurement: "{unit}"',
            ]
            if dev_cls:
                out.append(f"        device_class: {dev_cls}")
            out += [
                f"        state_class: {state_cls}",
                f"        state: >-",
                f"          {sine_state(low, high, period, phase)}",
            ]
        # energy is total_increasing: a ramp that resets daily, never decreasing
        out += [
            f"      - name: e2e {slug} energy",
            f"        unique_id: e2e_{slug}_energy",
            '        unit_of_measurement: "kWh"',
            "        device_class: energy",
            "        state_class: total_increasing",
            "        state: >-",
            "          {{ (((as_timestamp(now()) + %d) %% 86400) / 86400 * 12.0) | round(3) }}" % phase,
        ]

    # --- pumps: switch.sim_e2e_<slug>_{irrigation,drain}_pump ---
    # Must live under the `template:` key. The legacy
    # `switch: - platform: template` form is rejected by current HA:
    #   "Configuring the template integration under the switch platform key is
    #    not supported, it must be configured under its own template key"
    all_slugs = STAGE_SLUGS + VWC_SLUGS
    pumps = [(slug, kind) for slug in all_slugs for kind in ("irrigation_pump", "drain_pump")]

    out += ["  # ---------------------------------------------------------------",
            "  # pumps (toggleable, state backed by input_boolean)",
            "  # ---------------------------------------------------------------",
            "  - switch:"]
    for slug, kind in pumps:
        backing = f"input_boolean.sim_e2e_{slug}_{kind}"
        out += [
            f"      - name: sim e2e {slug} {kind}",
            f"        unique_id: sim_e2e_{slug}_{kind}",
            f"        state: \"{{{{ is_state('{backing}', 'on') }}}}\"",
            "        turn_on:",
            "          action: input_boolean.turn_on",
            "          target:",
            f"            entity_id: {backing}",
            "        turn_off:",
            "          action: input_boolean.turn_off",
            "          target:",
            f"            entity_id: {backing}",
        ]

    out += ["", "input_boolean:"]
    for slug, kind in pumps:
        out += [
            f"  sim_e2e_{slug}_{kind}:",
            f"    name: sim e2e {slug} {kind}",
            "    initial: false",
        ]

    out += ["", "input_number:"]
    for slug in VWC_SLUGS:
        for suffix, (unit, _dc, _sc, low, high, _p) in SIGNALS.items():
            start = round((low + high) / 2, 2)
            out += [
                f"  e2e_{slug}_{suffix}:",
                f"    name: e2e {slug} {suffix}",
                f"    min: {min(0, low)}",
                f"    max: {high * 2}",
                "    step: 0.01",
                f"    initial: {start}",
                f'    unit_of_measurement: "{unit}"',
                "    mode: box",
            ]
        out += [
            f"  e2e_{slug}_energy:",
            f"    name: e2e {slug} energy",
            "    min: 0",
            "    max: 100000",
            "    step: 0.001",
            "    initial: 5.0",
            '    unit_of_measurement: "kWh"',
            "    mode: box",
        ]

    ws = pathlib.Path(__file__).resolve().parent.parent
    dest = ws / "ha-dev" / "packages" / "e2e_simulated_sensors.yaml"
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text("\n".join(out) + "\n")

    n_tpl = len(STAGE_SLUGS) * (len(SIGNALS) + 1)
    n_num = len(VWC_SLUGS) * (len(SIGNALS) + 1)
    print(f"  wrote {dest.relative_to(ws)}")
    print(f"  {n_tpl} template sensors ({len(STAGE_SLUGS)} growspaces x {len(SIGNALS)+1})")
    print(f"  {n_num} input_number helpers ({len(VWC_SLUGS)} VWC growspaces x {len(SIGNALS)+1})")
    print(f"  {len(pumps)} pump switches ({len(all_slugs)} growspaces x 2)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
