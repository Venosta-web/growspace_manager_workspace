#!/usr/bin/env python3
"""
Seed the dev instance's Demo Tent with the content a demo walks through.

  ./scripts/seed-demo                          # plants, then Vision history
  ./scripts/seed-demo --growspace "E2E Vision"
  ./scripts/seed-demo --no-vision              # plants only
  ./scripts/seed-demo --list                   # what can be targeted
  ./scripts/seed-demo --clear                  # remove what this seeded

The `demo` capability profile in `e2e/entity_coverage.py` owns the growspace's
entities and wiring; the card fixture that applies it places a single anchor
plant in a 2x2 grid, which is right for a test fixture and wrong for a demo.
This script owns the other half — the tent's **content** — so one command turns
a fresh clone's Demo Tent into something worth showing.

Nothing here is written behind Home Assistant's back. The roster goes in through
`growspace_manager.add_strain` and `add_plant` on the running instance, so the
plants get their entities, their timeline and their stage arithmetic from the
shipped implementation, exactly as if a grower had typed them into the card. The
one thing that is invented is the calendar: stage dates are expressed as days
before today, so the tent reads the same on any day it is seeded.

Vision evidence is not reimplemented here. `./scripts/seed-vision-history` owns
it, and this script calls it, so the two cannot drift and one command leaves a
fresh clone demo-ready.

Prerequisites: Home Assistant must be up with the growspace already declared
(`./scripts/ha dev up`, then `./scripts/e2e provision` on a fresh clone), and a
long-lived token in `.ha-token` (`./scripts/ha dev token`). The delegated Vision
seeding additionally needs the Vision App; `--no-vision` skips it.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import pathlib
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import date, timedelta

# --------------------------------------------------------------------------
# checkouts
#
# The runtime belongs to the MAIN hub checkout: ha-dev/ is bind-mounted from
# beside docker-compose.yml and `scripts/ha` refuses to drive it from anywhere
# else, so its token and its growspace store are the ones to read whichever
# checkout this script was invoked from. The declarations and the sibling
# scripts, in contrast, are code — those come from THIS checkout, so a worktree
# exercises its own branch.
# --------------------------------------------------------------------------
HERE = pathlib.Path(__file__).resolve().parent.parent


def main_hub_checkout() -> pathlib.Path:
    """Return the main hub checkout, even when run from one of its worktrees."""
    try:
        common = subprocess.run(
            [
                "git",
                "-C",
                str(HERE),
                "rev-parse",
                "--path-format=absolute",
                "--git-common-dir",
            ],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return HERE
    return pathlib.Path(common).parent.resolve()


WORKSPACE = main_hub_checkout()
HA_DEV = WORKSPACE / "ha-dev"
CONFIG_STORE = HA_DEV / ".storage" / "growspace_manager.config"
TOKEN_FILE = pathlib.Path(os.environ.get("E2E_TOKEN_FILE", WORKSPACE / ".ha-token"))
HA_URL = os.environ.get("HA_BASE_URL", "http://127.0.0.1:8123")

SEED_VISION_HISTORY = HERE / "scripts" / "seed-vision-history"
COVERAGE = HERE / "e2e" / "entity_coverage.py"

# The demo dashboard (.storage/lovelace.demo_tent) is a panel view holding one
# card pinned to this growspace, so it is what "the demo setup" means here.
DEFAULT_GROWSPACE = "Demo Tent"

# The placeholder the card's own setup fixture drops into every growspace it
# creates. It is a test fixture's anchor, not demo content, and it sits on
# (1,1) — the first position this roster wants — so the demo evicts it.
FIXTURE_ANCHOR_STRAIN = "E2E Anchor"


def die(message: str) -> None:
    """Exit with a message on stderr."""
    sys.exit(f"error: {message}")


# --------------------------------------------------------------------------
# Home Assistant
#
# Everything the roster needs is on the REST API. Plants are entities — each one
# carries its own `plant_id`, `growspace_id`, `row`, `col`, `strain` and
# `phenotype` — so `/api/states` is a live read of the roster, with none of the
# staleness of `.storage/growspace_manager.plants`, which Home Assistant only
# flushes ten seconds after the fact and would make a second run place
# duplicates.
# --------------------------------------------------------------------------
class HomeAssistant:
    """The running dev instance, over its REST API."""

    def __init__(self, base_url: str, token: str) -> None:
        """Hold the endpoint and the long-lived token."""
        self._base_url = base_url.rstrip("/")
        self._token = token

    def _request(self, method: str, path: str, payload: dict | None = None) -> object:
        request = urllib.request.Request(
            f"{self._base_url}{path}",
            method=method,
            data=None if payload is None else json.dumps(payload).encode(),
            headers={
                "Authorization": f"Bearer {self._token}",
                "Content-Type": "application/json",
            },
        )
        with urllib.request.urlopen(request, timeout=60) as response:
            body = response.read()
        return json.loads(body) if body else None

    def connect(self) -> None:
        """Fail early and legibly rather than mid-roster."""
        try:
            self._request("GET", "/api/")
        except urllib.error.HTTPError as error:
            die(
                f"Home Assistant rejected the token from {TOKEN_FILE}: {error}\n"
                "       mint a new one with ./scripts/ha dev token"
            )
        except (urllib.error.URLError, TimeoutError) as error:
            die(
                f"Home Assistant is not reachable at {self._base_url}: {error}\n"
                "       start it with ./scripts/ha dev up"
            )
        services = self._request("GET", "/api/services")
        if not any(row.get("domain") == "growspace_manager" for row in services):
            die(
                "the growspace_manager integration is not set up on this instance;"
                " run ./scripts/e2e provision"
            )

    def states(self) -> list[dict]:
        """Every entity state, with attributes."""
        return self._request("GET", "/api/states")

    def call(self, service: str, data: dict) -> None:
        """Call a growspace_manager service."""
        try:
            self._request("POST", f"/api/services/growspace_manager/{service}", data)
        except urllib.error.HTTPError as error:
            detail = error.read().decode(errors="replace").strip()
            die(f"growspace_manager.{service} failed: {error} {detail}")


def read_token() -> str:
    """Read the long-lived token the same way scripts/e2e does."""
    token = os.environ.get("HA_ACCESS_TOKEN", "")
    if token:
        return token.strip()
    if not TOKEN_FILE.exists():
        die(f"{TOKEN_FILE} not found — create one with ./scripts/ha dev token")
    token = TOKEN_FILE.read_text().strip()
    if not token:
        die(f"{TOKEN_FILE} is empty — create one with ./scripts/ha dev token")
    return token


@dataclass(frozen=True)
class Growspace:
    """A growspace this script can target, as the running instance reports it."""

    growspace_id: str
    name: str


@dataclass(frozen=True)
class Plant:
    """One plant already in the target, as its own entity reports it."""

    plant_id: str
    row: int
    col: int
    strain: str
    phenotype: str


def read_growspaces(states: list[dict]) -> list[Growspace]:
    """Every growspace, read off the overview sensors' identity block."""
    found = []
    for state in states:
        identity = state["attributes"].get("identity")
        if not isinstance(identity, dict) or not identity.get("growspace_id"):
            continue
        found.append(
            Growspace(identity["growspace_id"], identity.get("name", "") or "")
        )
    return found


def read_plants(states: list[dict], growspace_id: str) -> list[Plant]:
    """Every plant in one growspace. A plant state is one carrying a plant_id."""
    plants = []
    for state in states:
        attributes = state["attributes"]
        if not attributes.get("plant_id"):
            continue
        if attributes.get("growspace_id") != growspace_id:
            continue
        plants.append(
            Plant(
                attributes["plant_id"],
                int(attributes.get("row", 0)),
                int(attributes.get("col", 0)),
                str(attributes.get("strain", "")),
                str(attributes.get("phenotype", "") or ""),
            )
        )
    return plants


def read_stored_growspace(growspace_id: str) -> dict | None:
    """Return the integration's own record for a growspace, or None.

    The grid is the one thing the roster needs that no entity exposes, so it
    comes from the store on the host — the file the hub's design rule says to
    read rather than reach into a container for. A growspace created moments ago
    is not in it yet, because Home Assistant flushes on a delay, and None says so
    rather than guessing; that is safe here because a growspace that new is the
    2x2 the card's fixture just made.
    """
    if not CONFIG_STORE.exists():
        return None
    growspaces = json.loads(CONFIG_STORE.read_text())["data"]["growspaces"]
    return growspaces.get(growspace_id)


def read_grid(growspace_id: str) -> tuple[int, int] | None:
    """Return the growspace's (rows, plants_per_row), or None if not on disk yet."""
    stored = read_stored_growspace(growspace_id)
    if not stored:
        return None
    return int(stored.get("rows", 0)), int(stored.get("plants_per_row", 0))


# --------------------------------------------------------------------------
# the stage anchor
#
# The demo profile declares what stage the growspace is in — `flower_start`, 40
# days back as this is written — and the dashboard, the controllers and the VPD
# targets all read off that. The roster's main cohort therefore sits exactly on
# it and every other cohort is an offset from it in days, so the tent the profile
# describes and the plants standing in it cannot drift apart.
# --------------------------------------------------------------------------
def demo_stage_anchor() -> tuple[str, int]:
    """Return the demo profile's declared (stage date field, days ago)."""
    if not COVERAGE.exists():
        die(f"no entity-coverage declaration at {COVERAGE}")
    spec = importlib.util.spec_from_file_location("entity_coverage", COVERAGE)
    module = importlib.util.module_from_spec(spec)
    # `dataclasses` resolves a field's declaring module through sys.modules, so a
    # module executed out of a file has to be registered before it is run.
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    for profile in module.PROFILES:
        for instance in profile.instances:
            if instance.name == DEFAULT_GROWSPACE:
                return instance.plant_stage_field, instance.stage_days_ago
    die(f"no profile instance declares a growspace named {DEFAULT_GROWSPACE!r}")


STAGE_FIELD, ANCHOR_DAYS = demo_stage_anchor()
if STAGE_FIELD != "flower_start":
    die(
        f"the demo profile now declares {STAGE_FIELD!r} rather than 'flower_start';"
        " this roster tells a flowering tent's story and has to be rewritten"
    )

LATE_FLOWER = ANCHOR_DAYS + 19  # nine weeks in — the cohort coming down first
MID_FLOWER = ANCHOR_DAYS  # the stage the profile declares for the growspace
EARLY_FLOWER = ANCHOR_DAYS - 10  # four weeks in, stretch over and bulking
JUST_FLIPPED = 4  # switched to 12/12 four days ago
VEG = 37  # in veg since before that flip


@dataclass(frozen=True)
class Slot:
    """One plant, at the grid position the demo expects to find it in."""

    row: int
    col: int
    strain: str
    phenotype: str = ""


@dataclass(frozen=True)
class Cohort:
    """One planting: the same stage dates across a run of grid positions."""

    label: str
    stages: dict[str, int]
    slots: tuple[Slot, ...]


# --------------------------------------------------------------------------
# the roster
#
# Plantings a fortnight or so apart, which is what makes the tent worth
# demonstrating: one growspace showing late, mid and early flower, a plant four
# days past the flip, and the veg pair coming up behind it. Rows are cohorts
# because that is how a perpetual tent is actually run. The last three positions
# are left empty on purpose — a demo should have somewhere to add a plant.
# --------------------------------------------------------------------------
ROSTER: tuple[Cohort, ...] = (
    Cohort(
        "late flower",
        {"flower_start": LATE_FLOWER},
        (
            Slot(1, 1, "Wedding Cake", "Pheno #2"),
