            Slot(1, 5, "Zkittlez"),
        ),
    ),
    Cohort(
        "mid flower",
        {"flower_start": MID_FLOWER},
        (
            Slot(2, 1, "Blue Dream"),
            Slot(2, 2, "Northern Lights", "NL#5"),
            Slot(2, 3, "Purple Punch"),
            Slot(2, 4, "Blue Dream"),
            Slot(2, 5, "OG Kush", "Cut B"),
        ),
    ),
    Cohort(
        "early flower",
        {"flower_start": EARLY_FLOWER},
        (
            Slot(3, 1, "Bruce Banner"),
            Slot(3, 2, "White Widow"),
            Slot(3, 3, "Sour Diesel", "East Cut"),
            Slot(3, 4, "Amnesia Haze"),
