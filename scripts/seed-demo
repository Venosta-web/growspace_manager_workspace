def slots() -> tuple[tuple[Slot, Cohort], ...]:
    """Every roster slot with its cohort, refusing two plants on one position."""
    seen: dict[tuple[int, int], str] = {}
    pairs = []
    for cohort in ROSTER:
        for slot in cohort.slots:
            position = (slot.row, slot.col)
            if position in seen:
                die(
                    f"the roster puts two plants on ({slot.row},{slot.col}): "
                    f"{seen[position]} and {cohort.label}"
                )
            seen[position] = cohort.label
            pairs.append((slot, cohort))
    return tuple(pairs)


def roster_extent() -> tuple[int, int]:
    """The smallest grid the roster fits in."""
    return (
        max(slot.row for slot, _ in slots()),
        max(slot.col for slot, _ in slots()),
    )


def plural(count: int, noun: str) -> str:
    """Render a count with its noun, so a report of one reads like English."""
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def stage_date(days_ago: int) -> str:
    """Render a stage date `days_ago` days before today, as the service wants it."""
    return (date.today() - timedelta(days=days_ago)).isoformat()


def resolve_target(wanted: str, growspaces: list[Growspace]) -> Growspace:
    """Resolve a growspace by id or by name."""
    for growspace in growspaces:
        if growspace.growspace_id == wanted:
            return growspace
    matches = [g for g in growspaces if g.name.casefold() == wanted.casefold()]
    if not matches:
        die(
            f"no growspace {wanted!r} — run with --list to see the choices.\n"
            "       On a fresh clone the demo growspace is declared by"
            " ./scripts/e2e provision."
        )
    if len(matches) > 1:
        die(f"{wanted!r} names {len(matches)} growspaces; pass an id instead")
    return matches[0]


def list_targets(states: list[dict]) -> int:
    """Print every growspace that can be seeded, and what is standing in it."""
    rows, cols = roster_extent()
    print(f"  instance: {HA_URL}")
    print(f"  roster:   {len(slots())} plants over {rows}x{cols}")
    for growspace in read_growspaces(states):
        plants = read_plants(states, growspace.growspace_id)
        grid = read_grid(growspace.growspace_id)
        shape = f"{grid[0]}x{grid[1]}" if grid else "?"
        seeded = sum(1 for plant in plants if is_seeded(plant))
        note = f"{len(plants):>2} plants, {seeded:>2} from this roster"
        print(f"  {growspace.name:<26} {growspace.growspace_id:<36} {shape:>5}  {note}")
    return 0


def is_seeded(plant: Plant) -> bool:
    """Whether a plant is one this script placed.

    A roster slot is a position and a strain, so a plant standing on a declared
    position under that position's declared strain is this script's and nobody
    else's. Anything else in the tent — a plant somebody added while demoing, a
    strain swapped by hand — is left alone by --clear.
    """
    for slot, _ in slots():
        if (plant.row, plant.col) == (slot.row, slot.col):
            return plant.strain == slot.strain
    return False


# --------------------------------------------------------------------------
# seeding
# --------------------------------------------------------------------------
def ensure_strains(hass: HomeAssistant) -> int:
    """Put every strain and phenotype the roster names into the library."""
    used = {slot.strain for slot, _ in slots()}
    declared = {str(strain["strain"]) for strain in STRAINS}
    missing = used - declared
    if missing:
        die(f"the roster names strains this script does not declare: {sorted(missing)}")

    for strain in STRAINS:
        if strain["strain"] not in used:
            continue
        hass.call("add_strain", dict(strain))
    phenotypes = {
        (slot.strain, slot.phenotype) for slot, _ in slots() if slot.phenotype
    }
    for strain_name, phenotype in sorted(phenotypes):
        hass.call("add_strain", {"strain": strain_name, "phenotype": phenotype})
    return len(used) + len(phenotypes)


def ensure_grid(hass: HomeAssistant, target: Growspace) -> str:
    """Grow the tent to at least the roster's extent, never shrinking it.

    `update_growspace` reads every field off the call and writes it through, so a
    field left out is written as None rather than left alone — omitting `name`
    erases the growspace's name. It is a replace, not a patch, so everything this
    is not changing is resent with it.
    """
    rows, cols = roster_extent()
    stored = read_stored_growspace(target.growspace_id) or {}
    grid = read_grid(target.growspace_id)
    if grid and grid[0] >= rows and grid[1] >= cols:
        return f"{grid[0]}x{grid[1]}  [already fits]"
    wanted = (max(rows, grid[0]), max(cols, grid[1])) if grid else (rows, cols)
    payload = {
        "growspace_id": target.growspace_id,
        "name": target.name,
        "rows": wanted[0],
        "plants_per_row": wanted[1],
    }
    if stored.get("notification_target"):
        payload["notification_target"] = stored["notification_target"]
    hass.call("update_growspace", payload)
    was = f"{grid[0]}x{grid[1]}" if grid else "a fixture's grid"
    return f"{wanted[0]}x{wanted[1]}  [grown from {was}]"


def evict_fixture_anchor(hass: HomeAssistant, plants: list[Plant]) -> int:
    """Remove the card fixture's anchor plant, which the roster replaces."""
    removed = 0
    for plant in plants:
        if plant.strain != FIXTURE_ANCHOR_STRAIN:
            continue
        hass.call("remove_plant", {"plant_id": plant.plant_id})
        removed += 1
    return removed


def seed_plants(hass: HomeAssistant, target: Growspace, plants: list[Plant]) -> dict:
    """Place every roster slot that is not standing already.

    `add_plant` silently relocates to the next free position when the one it was
    given is taken, so occupancy is decided here rather than left to the service
    — that is what keeps a second run from stacking a duplicate roster into the
    empty half of the tent.
    """
    occupied = {(plant.row, plant.col): plant for plant in plants}
    counts = {"placed": 0, "present": 0, "occupied": 0}
    for slot, cohort in slots():
        standing = occupied.get((slot.row, slot.col))
        if standing is not None:
            if standing.strain == slot.strain:
                counts["present"] += 1
            else:
                counts["occupied"] += 1
                print(
                    f"    ({slot.row},{slot.col}) holds {standing.strain} rather than "
                    f"{slot.strain} — left alone"
                )
            continue
        hass.call(
            "add_plant",
            {
                "growspace_id": target.growspace_id,
                "strain": slot.strain,
                "phenotype": slot.phenotype,
                "row": slot.row,
                "col": slot.col,
                **{field: stage_date(days) for field, days in cohort.stages.items()},
            },
        )
        counts["placed"] += 1
    return counts


def clear_plants(hass: HomeAssistant, plants: list[Plant]) -> int:
    """Remove the plants this script seeded, leaving the growspace itself alone."""
    removed = 0
    for plant in plants:
        if not is_seeded(plant):
            continue
        hass.call("remove_plant", {"plant_id": plant.plant_id})
        removed += 1
    return removed


# --------------------------------------------------------------------------
# the Vision evidence, which this script does not own
# --------------------------------------------------------------------------
def seed_vision_history(target: Growspace, extra: list[str]) -> int:
    """Delegate to ./scripts/seed-vision-history for the Vision Checkup history."""
    if not SEED_VISION_HISTORY.exists():
        die(f"no {SEED_VISION_HISTORY}")
    command = [
        sys.executable,
        str(SEED_VISION_HISTORY),
        "--growspace",
        target.growspace_id,
        *extra,
    ]
    print(f"  $ {' '.join(command[1:])}")
    # The child writes straight to the terminal; flush first so its output does
    # not land above this script's when stdout is a pipe rather than a tty.
    sys.stdout.flush()
    return subprocess.run(command, check=False).returncode


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------
def parse_args(argv):
    """Parse the command line."""
    parser = argparse.ArgumentParser(
        description="Seed the dev instance's Demo Tent with the demo's content.",
    )
    parser.add_argument(
        "--growspace",
        default=DEFAULT_GROWSPACE,
        help="growspace id or name (default: %(default)s)",
    )
    parser.add_argument(
        "--no-vision",
        action="store_true",
        help="skip the delegated Vision Checkup history",
    )
    parser.add_argument(
        "--vision-days",
        type=int,
        default=None,
        help="days of Vision history (default: seed-vision-history's own)",
    )
    parser.add_argument(
        "--clear",
        action="store_true",
        help="remove the plants this seeded, and the evidence, and exit",
    )
    parser.add_argument(
        "--list", action="store_true", help="list the growspaces that can be seeded"
    )
    return parser.parse_args(argv)


def main(argv) -> int:
    """Seed, clear or list."""
    args = parse_args(argv)
    print(f"  workspace: {WORKSPACE}")
    print(f"  scripts:   {HERE}")

    hass = HomeAssistant(HA_URL, read_token())
    hass.connect()
    states = hass.states()

    if args.list:
        return list_targets(states)

    target = resolve_target(args.growspace, read_growspaces(states))
    plants = read_plants(states, target.growspace_id)
    print(f"  instance:  {HA_URL}")
    print(f"  growspace: {target.name}  ({target.growspace_id})")

    if args.clear:
        removed = clear_plants(hass, plants)
        print(
            f"  removed {plural(removed, 'seeded plant')};"
            " the growspace itself is untouched"
        )
        if args.no_vision:
            return 0
        print("  clearing the Vision evidence ...")
        return seed_vision_history(target, ["--clear"])

    print(f"  strains:   {ensure_strains(hass)} library entries")
    print(f"  grid:      {ensure_grid(hass, target)}")
    evicted = evict_fixture_anchor(hass, plants)
    if evicted:
        print(f"  evicted {plural(evicted, f'{FIXTURE_ANCHOR_STRAIN} fixture plant')}")
        plants = [p for p in plants if p.strain != FIXTURE_ANCHOR_STRAIN]

    counts = seed_plants(hass, target, plants)
    print(
        f"  planted {counts['placed']}, {counts['present']} already standing, "
        f"{plural(counts['occupied'], 'position')} held by something else"
    )
    for cohort in ROSTER:
        stages = "  ".join(
            f"{field.removesuffix('_start')} day {days}"
            for field, days in cohort.stages.items()
        )
        print(
            f"    {cohort.label:<14} {plural(len(cohort.slots), 'plant'):>9}   {stages}"
        )

    if args.no_vision:
        print()
        print("  Vision history skipped. Seed it with:")
        print(f"    ./scripts/seed-vision-history --growspace {target.name!r}")
        return 0

    print()
    print("  seeding the Vision Checkup history ...")
    extra = [] if args.vision_days is None else ["--days", str(args.vision_days)]
    status = seed_vision_history(target, extra)
    if status != 0:
        print()
        print(
            "  NOTE: the roster is in place; only the Vision history failed. "
            "Retry it on its own once the Vision App is up."
        )
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
