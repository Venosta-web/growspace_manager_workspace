#!/usr/bin/env bash
# Matched cross-repo git worktrees for parallel agent work.
#
# A growspace feature normally spans a Python integration and the card, so a
# worktree in only one of them is a trap: the agent edits one side and silently
# validates the card from its base branch. The default remains backend + card;
# --tc creates the TC + card pair on the same branch name.
#
#   ./scripts/feature new  irrigation-v2 [--backend-only|--card-only]
#   ./scripts/feature new  culture-lines --tc
#   ./scripts/feature new  shared-contract --all
#   ./scripts/feature list
#   ./scripts/feature env  irrigation-v2   # (re)prepare its Python venvs
#   ./scripts/feature rm   irrigation-v2
#
# LAYOUT — this matters, do not "tidy" it:
#
#   growspace_manager/.worktrees/<name>          real backend worktree
#   worktrees/<name>/backend  -> symlink to it   paired view
#   growspace_manager_tc/.worktrees/<name>       real TC worktree
#   worktrees/<name>/tc       -> symlink to it   paired view
#   worktrees/<name>/card                        real card worktree
#
# The backend and TC worktrees live at <repo>/.worktrees/<name> (gitignored in
# the Python repositories).
#
# scripts/backend-venv creates a private <worktree>/.venv and refuses a branch
# with fixed-path hooks until it is rebased onto a hook-runner base. `env`
# re-runs setup for an existing pair to replace a link or rebuild a drifted venv. See
# docs/adr/0004-python-hooks-run-the-worktrees-own-venv.md.
#
# Base branch: upstream integrates architecture/refactor work on `prerelease`.
# Override with BASE=main ./scripts/feature new <name>
set -euo pipefail

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Repositories and the pair root both belong to the MAIN hub checkout, so a pair
# made from a hub worktree is the same pair, in the same place, as one made from
# the hub itself — and outlives the worktree it was made from.
HUB="$("$WS/scripts/growspace-repos" --hub)"
BACKEND="$("$WS/scripts/growspace-repos" growspace_manager)"
TC="$("$WS/scripts/growspace-repos" growspace_manager_tc)"
CARD="$("$WS/scripts/growspace-repos" lovelace-growspace-manager-card)"
ROOT="$HUB/worktrees"
BASE="${BASE:-prerelease}"

add_wt() { # repo, dest, branch
  local repo="$1" dest="$2" branch="$3"
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" worktree add "$dest" "$branch"
  else
    git -C "$repo" fetch --quiet origin || true
    git -C "$repo" worktree add -b "$branch" "$dest" "origin/$BASE" 2>/dev/null \
      || git -C "$repo" worktree add -b "$branch" "$dest" "origin/main" 2>/dev/null \
      || git -C "$repo" worktree add -b "$branch" "$dest" main
  fi
}

case "${1:-}" in
  new)
    NAME="${2:?feature name required}"
    BRANCH="feature/$NAME"
    SCOPE="${3:-both}"
    WANT_BACKEND=0
    WANT_CARD=0
    WANT_TC=0
    case "$SCOPE" in
      both)                    WANT_BACKEND=1; WANT_CARD=1 ;;
      --backend-only)          WANT_BACKEND=1 ;;
      --card-only)             WANT_CARD=1 ;;
      --tc|--tc-card)          WANT_TC=1; WANT_CARD=1 ;;
      --tc-only)               WANT_TC=1 ;;
      --all)                   WANT_BACKEND=1; WANT_TC=1; WANT_CARD=1 ;;
      *)
        echo "usage: $0 new <name> [--backend-only|--card-only|--tc|--tc-only|--all]" >&2
        exit 2
        ;;
    esac
    mkdir -p "$ROOT/$NAME"

    if [ "$WANT_BACKEND" -eq 1 ]; then
      BW="$BACKEND/.worktrees/$NAME"
      add_wt "$BACKEND" "$BW" "$BRANCH"
      ln -sfn "$BW" "$ROOT/$NAME/backend"
      # The environment can only be checked once the branch is checked out, so a
      # refusal necessarily arrives with the worktree already created. Say so.
      "$WS/scripts/backend-venv" "$BACKEND" "$BW" || {
        echo >&2
        echo "The backend worktree exists at $BW but has no usable environment." >&2
        echo "Fix the venv above, then: ./scripts/feature env $NAME" >&2
        echo "or discard it with:       ./scripts/feature rm $NAME" >&2
        exit 1
      }
    fi

    if [ "$WANT_TC" -eq 1 ]; then
      TW="$TC/.worktrees/$NAME"
      add_wt "$TC" "$TW" "$BRANCH"
      ln -sfn "$TW" "$ROOT/$NAME/tc"
      "$WS/scripts/backend-venv" "$TC" "$TW" tc || {
        echo >&2
        echo "The TC worktree exists at $TW but has no usable environment." >&2
        echo "Fix the venv above, then: ./scripts/feature env $NAME" >&2
        echo "or discard it with:       ./scripts/feature rm $NAME" >&2
        exit 1
      }
    fi

    if [ "$WANT_CARD" -eq 1 ]; then
      add_wt "$CARD" "$ROOT/$NAME/card" "$BRANCH"
      "$WS/scripts/card-node-modules" "$CARD" "$ROOT/$NAME/card"
    fi

    echo
    echo "✓ feature '$NAME' ready on branch $BRANCH (base: origin/$BASE)"
    if [ -e "$ROOT/$NAME/backend" ]; then
      echo "   backend: $BACKEND/.worktrees/$NAME"
      echo "            (also at $ROOT/$NAME/backend)"
      echo "            tests:  .venv/bin/pytest tests/ -q"
    fi
    if [ -e "$ROOT/$NAME/tc" ]; then
      echo "   tc:      $TC/.worktrees/$NAME"
      echo "            (also at $ROOT/$NAME/tc)"
      echo "            tests:  .venv/bin/pytest tests/ -q"
    fi
    [ -d "$ROOT/$NAME/card" ] && echo "   card:    $ROOT/$NAME/card"
    echo
    echo "Cross-repo roots are grouped under: $ROOT/$NAME"
    ;;

  list)
    echo "── backend ──"; git -C "$BACKEND" worktree list
    echo; echo "── TC ──";      git -C "$TC"      worktree list
    echo; echo "── card ──";  git -C "$CARD"    worktree list
    ;;

  env)
    NAME="${2:?feature name required}"
    FOUND=0
    FAILED=0
    if [ -d "$BACKEND/.worktrees/$NAME" ]; then
      FOUND=1
      "$WS/scripts/backend-venv" "$BACKEND" "$BACKEND/.worktrees/$NAME" backend || FAILED=1
    fi
    if [ -d "$TC/.worktrees/$NAME" ]; then
      FOUND=1
      "$WS/scripts/backend-venv" "$TC" "$TC/.worktrees/$NAME" tc || FAILED=1
    fi
    if [ "$FOUND" -eq 0 ]; then
      echo "ERROR: no backend or TC worktree named '$NAME'" >&2
      echo "  looked for $BACKEND/.worktrees/$NAME" >&2
      echo "         and $TC/.worktrees/$NAME" >&2
      exit 1
    fi
    exit "$FAILED"
    ;;

  rm)
    NAME="${2:?feature name required}"
    [ -L "$ROOT/$NAME/card/node_modules" ] && unlink "$ROOT/$NAME/card/node_modules"
    [ -L "$BACKEND/.worktrees/$NAME/.venv" ] && unlink "$BACKEND/.worktrees/$NAME/.venv"
    [ -L "$TC/.worktrees/$NAME/.venv" ] && unlink "$TC/.worktrees/$NAME/.venv"
    rm -f "$ROOT/$NAME/backend"
    rm -f "$ROOT/$NAME/tc"
    git -C "$BACKEND" worktree remove --force "$BACKEND/.worktrees/$NAME" 2>/dev/null || true
    git -C "$TC"      worktree remove --force "$TC/.worktrees/$NAME"           2>/dev/null || true
    git -C "$CARD"    worktree remove --force "$ROOT/$NAME/card"          2>/dev/null || true
    rmdir "$ROOT/$NAME" 2>/dev/null || true
    git -C "$BACKEND" worktree prune; git -C "$TC" worktree prune; git -C "$CARD" worktree prune
    echo "✓ removed worktrees for '$NAME' (branches kept)"
    ;;

  *) sed -n '2,37p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 2 ;;
esac
