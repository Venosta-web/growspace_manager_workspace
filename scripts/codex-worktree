#!/usr/bin/env bash
# Create and address the matched backend/TC/card/Vision set used by a Codex-managed
# worktree of this workspace hub.
set -euo pipefail

HUB_WORKTREE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_HUB="$("$HUB_WORKTREE/scripts/growspace-repos" --hub)"
BACKEND_REPO="$("$HUB_WORKTREE/scripts/growspace-repos" growspace_manager)"
TC_REPO="$("$HUB_WORKTREE/scripts/growspace-repos" growspace_manager_tc)"
CARD_REPO="$("$HUB_WORKTREE/scripts/growspace-repos" lovelace-growspace-manager-card)"
VISION_REPO="$("$HUB_WORKTREE/scripts/growspace-repos" growspace_manager_vision)"

WORKTREE_KEY="$(printf '%s' "$HUB_WORKTREE" | sha256sum | cut -c1-12)"
NAME="codex-$WORKTREE_KEY"
BRANCH="codex/$NAME"
PAIR_ROOT="$HUB_WORKTREE/worktrees/$NAME"
BACKEND_CONTAINER="$PAIR_ROOT/growspace_manager"
BACKEND_WORKTREE="$BACKEND_CONTAINER/.worktrees/backend"
TC_CONTAINER="$PAIR_ROOT/growspace_manager_tc"
TC_WORKTREE="$TC_CONTAINER/.worktrees/tc"
CARD_WORKTREE="$PAIR_ROOT/card"
VISION_WORKTREE="$PAIR_ROOT/vision"

require_repo() {
  local repo="$1"
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "ERROR: expected Git repository at $repo" >&2
    exit 1
  }
}

# Where each worktree came from, for the summary: its base when this run made
# it, otherwise that it already existed.
declare -A FROM=()

# A new worktree starts from the base scripts/growspace-repos names for its
# repository — the same one scripts/feature uses — and refuses when that base
# is missing rather than settling for another branch. An existing worktree is
# left alone, so a later `check` or `status` never needs the base at all.
add_worktree() {
  local repo="$1" name="$2" destination="$3" base

  if [ -d "$destination" ] && git -C "$destination" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    FROM[$name]="existing worktree"
    return
  fi
  if [ -e "$destination" ]; then
    echo "ERROR: worktree destination already exists: $destination" >&2
    exit 1
  fi

  if git -C "$repo" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    mkdir -p "$(dirname "$destination")"
    git -C "$repo" worktree add "$destination" "$BRANCH"
    FROM[$name]="existing branch $BRANCH"
  else
    git -C "$repo" fetch --quiet origin || true
    base="$("$HUB_WORKTREE/scripts/growspace-repos" --base "$name")"
    mkdir -p "$(dirname "$destination")"
    git -C "$repo" worktree add -b "$BRANCH" "$destination" "$base"
    FROM[$name]="base $base"
  fi
}

link_node_modules() {
  "$HUB_WORKTREE/scripts/card-node-modules" "$CARD_REPO" "$CARD_WORKTREE"
}

# Every Python worktree in this set gets a real private venv at its own .venv.
# scripts/backend-venv refuses fixed-path hooks until the branch is rebased
# onto a base with the hook runner. uv hardlinks from its cache, so this costs
# ~7.9 MiB and ~0.4 s warm, and it is the only way to
# contain `uv venv --clear`, which through a link destroys the lender's venv.
# See docs/adr/0002-private-backend-venvs-for-hub-managed-worktrees.md and
# docs/adr/0004-python-hooks-run-the-worktrees-own-venv.md.
prepare_backend_venv() {
  "$HUB_WORKTREE/scripts/backend-venv" "$BACKEND_REPO" "$BACKEND_WORKTREE" backend
}

prepare_tc_venv() {
  "$HUB_WORKTREE/scripts/backend-venv" "$TC_REPO" "$TC_WORKTREE" tc
}

setup_pair() {
  require_repo "$BACKEND_REPO"
  require_repo "$TC_REPO"
  require_repo "$CARD_REPO"
  require_repo "$VISION_REPO"
  # Not because this pair runs it — it builds its own — but because that venv
  # is where the uv binary and the hub's documented setup live.
  [ -x "$BACKEND_REPO/.venv/bin/python" ] || {
    echo "ERROR: main backend venv missing at $BACKEND_REPO/.venv" >&2
    exit 1
  }
  [ -d "$CARD_REPO/node_modules" ] || {
    echo "ERROR: shared card dependencies missing at $CARD_REPO/node_modules" >&2
    exit 1
  }
  [ -x "$VISION_REPO/.venv/bin/python" ] || {
    echo "ERROR: main Vision test environment missing at $VISION_REPO/.venv" >&2
    exit 1
  }

  mkdir -p "$BACKEND_CONTAINER" "$TC_CONTAINER" "$PAIR_ROOT/.cache"
  add_worktree "$BACKEND_REPO" growspace_manager "$BACKEND_WORKTREE"
  add_worktree "$TC_REPO" growspace_manager_tc "$TC_WORKTREE"
  add_worktree "$CARD_REPO" lovelace-growspace-manager-card "$CARD_WORKTREE"
  add_worktree "$VISION_REPO" growspace_manager_vision "$VISION_WORKTREE"
  ln -sfn "$BACKEND_WORKTREE" "$PAIR_ROOT/backend"
  ln -sfn "$TC_WORKTREE" "$PAIR_ROOT/tc"
  prepare_backend_venv
  prepare_tc_venv
  link_node_modules

  printf 'Matched Codex worktrees ready on %s\n' "$BRANCH"
  printf '  backend: %s  (%s)\n' "$BACKEND_WORKTREE" "${FROM[growspace_manager]}"
  printf '  tc:      %s  (%s)\n' "$TC_WORKTREE" "${FROM[growspace_manager_tc]}"
  printf '  card:    %s  (%s)\n' "$CARD_WORKTREE" "${FROM[lovelace-growspace-manager-card]}"
  printf '  vision:  %s  (%s)\n' "$VISION_WORKTREE" "${FROM[growspace_manager_vision]}"
  printf '  pair:    %s\n' "$PAIR_ROOT"
}

run_check() {
  local target="${1:-all}" level="${2:-fast}"
  setup_pair >/dev/null
  export GROWSPACE_BACKEND="$BACKEND_WORKTREE"
  export GROWSPACE_TC="$TC_WORKTREE"
  export GROWSPACE_CARD="$CARD_WORKTREE"
  export GROWSPACE_VISION="$VISION_WORKTREE"
  export GROWSPACE_VISION_PY="$VISION_REPO/.venv/bin/python"
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  export PYTHONDONTWRITEBYTECODE=1
  exec "$HUB_WORKTREE/scripts/check" "$target" "$level"
}

run_precommit() {
  setup_pair >/dev/null
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  export PYTHONDONTWRITEBYTECODE=1
  cd "$BACKEND_WORKTREE"
  exec ./.venv/bin/pre-commit run --all-files
}

run_card_precommit() {
  setup_pair >/dev/null
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  cd "$CARD_WORKTREE"
  exec "$BACKEND_REPO/.venv/bin/pre-commit" run --all-files
}

run_tc_precommit() {
  setup_pair >/dev/null
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  export PYTHONDONTWRITEBYTECODE=1
  cd "$TC_WORKTREE"
  exec ./.venv/bin/pre-commit run --all-files
}

# Wait until the shared dev runtime serves a card bundle again after a restart.
wait_for_card() {
  local code
  for _ in $(seq 1 60); do
    code="$(curl -s -o /dev/null -w '%{http_code}' \
      http://localhost:8123/local/community/lovelace-growspace-manager-card/growspace-manager-card.js 2>/dev/null || true)"
    [ "$code" = "200" ] && return 0
    sleep 2
  done
  return 1
}

# Point the shared dev runtime at a card dist/ and wait for it to serve again.
# scripts/ha refuses to run from a worktree — the compose file resolves ha-dev/
# and integration mounts relative to itself — so drive the main checkout's copy
# and override only the card bundle. scripts/ha keeps every mount it is not
# told about, so another session's backend or TC worktree stays mounted.
remount_card_dist() {
  local dist="$1"
  GROWSPACE_CARD_DIST="$dist" "$LOCAL_HUB/scripts/ha" dev restart >/dev/null
  wait_for_card || {
    echo "ERROR: HA did not serve the card bundle from $dist within 120s" >&2
    return 1
  }
  printf '→ HA serving %s\n' "$dist"
}

# Put the card mount back to what it was before this run. Only the card mount:
# it is the one this run changed, and the backend and TC mounts are inherited by
# the restart — so a session that remounted one of those while the suite ran
# keeps it, instead of being rolled back to what this run happened to see.
# A bundle that has gone since, or no container at all, means the main dist/.
restore_card_dist() {
  local previous="$1"
  if [ -n "$previous" ] && [ -e "$previous" ]; then
    GROWSPACE_CARD_DIST="$previous" "$LOCAL_HUB/scripts/ha" dev restart >/dev/null
  else
    "$LOCAL_HUB/scripts/ha" dev restart --main card >/dev/null
  fi
  wait_for_card
}

run_card_e2e() {
  local previous_card
  setup_pair >/dev/null
  [ -f "$CARD_WORKTREE/tests/e2e/.env.test" ] || {
    echo "ERROR: copy the card E2E config into $CARD_WORKTREE/tests/e2e/.env.test first" >&2
    exit 1
  }

  cd "$CARD_WORKTREE"

  # Build, then actually serve what was built. Without the remount, HA keeps
  # serving the main checkout's dist/ and the suite silently validates a bundle
  # this worktree never produced. rollup also deletes and recreates dist/, so
  # the remount has to happen after the build or Docker holds the dead inode.
  npm run build

  # The runtime is a singleton shared with other sessions; hand it back on the
  # way out however we exit, to exactly the card bundle it was serving — which
  # need not be the main checkout's.
  previous_card="$("$LOCAL_HUB/scripts/ha" dev mounts --porcelain | awk -F'\t' '$1 == "card" { print $3 }')"
  # shellcheck disable=SC2064  # expand now: the trap must restore what was seen here
  trap "restore_card_dist $(printf '%q' "$previous_card") >/dev/null 2>&1 || true" EXIT
  remount_card_dist "$CARD_WORKTREE/dist"

  npm run test:ha
}

case "${1:-setup}" in
  setup) setup_pair ;;
  path) printf '%s\n' "$PAIR_ROOT" ;;
  check) shift; run_check "$@" ;;
  precommit) run_precommit ;;
  tc-precommit) run_tc_precommit ;;
  card-precommit) run_card_precommit ;;
  card-e2e) run_card_e2e ;;
  status)
    setup_pair >/dev/null
    git -C "$BACKEND_WORKTREE" status --short --branch
    git -C "$TC_WORKTREE" status --short --branch
    git -C "$CARD_WORKTREE" status --short --branch
    git -C "$VISION_WORKTREE" status --short --branch
    ;;
  *)
    echo "usage: $0 {setup|path|status|precommit|tc-precommit|card-precommit|card-e2e|check [backend|tc|card|vision|all] [fast|full]}" >&2
    exit 2
    ;;
esac
