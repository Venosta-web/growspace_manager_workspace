#!/usr/bin/env bash
# Create and address the matched backend/card pair used by a Codex-managed
# worktree of this workspace hub.
set -euo pipefail

HUB_WORKTREE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HUB_COMMON_GIT_DIR="$(git -C "$HUB_WORKTREE" rev-parse --path-format=absolute --git-common-dir)"
LOCAL_HUB="$(dirname "$HUB_COMMON_GIT_DIR")"
DEV_ROOT="$(dirname "$LOCAL_HUB")"
BACKEND_REPO="$DEV_ROOT/growspace_manager"
CARD_REPO="$DEV_ROOT/lovelace-growspace-manager-card"

WORKTREE_KEY="$(printf '%s' "$HUB_WORKTREE" | sha256sum | cut -c1-12)"
NAME="codex-$WORKTREE_KEY"
BRANCH="codex/$NAME"
PAIR_ROOT="$HUB_WORKTREE/worktrees/$NAME"
BACKEND_CONTAINER="$PAIR_ROOT/growspace_manager"
BACKEND_WORKTREE="$BACKEND_CONTAINER/.worktrees/backend"
CARD_WORKTREE="$PAIR_ROOT/card"

require_repo() {
  local repo="$1"
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "ERROR: expected Git repository at $repo" >&2
    exit 1
  }
}

resolve_base() {
  local repo="$1" preferred="$2" candidate
  for candidate in \
    "refs/remotes/origin/$preferred" \
    "refs/heads/$preferred" \
    refs/remotes/origin/main \
    refs/heads/main; do
    if git -C "$repo" show-ref --verify --quiet "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  echo "ERROR: no usable $preferred or main base in $repo" >&2
  exit 1
}

add_worktree() {
  local repo="$1" destination="$2" base="$3"

  if [ -d "$destination" ] && git -C "$destination" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return
  fi
  if [ -e "$destination" ]; then
    echo "ERROR: worktree destination already exists: $destination" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$destination")"
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$repo" worktree add "$destination" "$BRANCH"
  else
    git -C "$repo" worktree add -b "$BRANCH" "$destination" "$base"
  fi
}

# How the card worktree gets its dependencies.
#
#   symlink (default) — one symlink to the main checkout's node_modules. This is
#     what scripts/feature does and what AGENTS.md documents. Nothing in the
#     worktree can write into the shared tree by accident.
#
#   farm — every package file symlinked individually (~24k links), with
#     .cache/.vite/.vite-temp as real local directories. Only Vite's caches are
#     genuinely per-worktree; that is the entire reason this mode exists, and it
#     is why the browser/e2e flows opt into it.
#
# The farm is a fallback, not the default, because a symlinked *file* is a
# write-through: anything that rewrites a file in place inside the worktree's
# node_modules (patch-package, a postinstall, npm rebuild) edits the main
# checkout's dependencies. Prefer `symlink` unless a tool actually needs to
# write into node_modules.
NODE_MODULES_MODE="${GROWSPACE_NODE_MODULES:-symlink}"

link_node_modules() {
  local nm="$CARD_WORKTREE/node_modules"

  case "$NODE_MODULES_MODE" in
    symlink)
      # A leftover farm is a real directory; replace it rather than nesting into it.
      if [ -d "$nm" ] && [ ! -L "$nm" ]; then
        rm -rf "$nm"
      fi
      ln -sfn "$CARD_REPO/node_modules" "$nm"
      ;;
    farm)
      [ -L "$nm" ] && unlink "$nm"
      mkdir -p "$nm"
      find "$CARD_REPO/node_modules" -mindepth 1 -maxdepth 1 \
        ! -name .cache ! -name .vite ! -name .vite-temp \
        -exec cp -as --update=none -t "$nm" {} +
      mkdir -p "$nm/.cache" "$nm/.vite" "$nm/.vite-temp"
      ;;
  esac
}

# Validated before setup_pair does any work, so a typo cannot leave a
# half-created pair behind.
require_node_modules_mode() {
  case "$NODE_MODULES_MODE" in
    symlink|farm) ;;
    *)
      echo "ERROR: GROWSPACE_NODE_MODULES must be 'symlink' or 'farm', got '$NODE_MODULES_MODE'" >&2
      exit 2
      ;;
  esac
}

setup_pair() {
  local backend_base card_base

  require_node_modules_mode
  require_repo "$BACKEND_REPO"
  require_repo "$CARD_REPO"
  [ -x "$BACKEND_REPO/.venv/bin/python" ] || {
    echo "ERROR: shared backend venv missing at $BACKEND_REPO/.venv" >&2
    exit 1
  }
  [ -d "$CARD_REPO/node_modules" ] || {
    echo "ERROR: shared card dependencies missing at $CARD_REPO/node_modules" >&2
    exit 1
  }

  backend_base="$(resolve_base "$BACKEND_REPO" "${CODEX_BACKEND_BASE:-prerelease}")"
  card_base="$(resolve_base "$CARD_REPO" "${CODEX_CARD_BASE:-dev}")"

  mkdir -p "$BACKEND_CONTAINER" "$PAIR_ROOT/.cache"
  ln -sfn "$BACKEND_REPO/.venv" "$BACKEND_CONTAINER/.venv"
  add_worktree "$BACKEND_REPO" "$BACKEND_WORKTREE" "$backend_base"
  add_worktree "$CARD_REPO" "$CARD_WORKTREE" "$card_base"
  ln -sfn "$BACKEND_WORKTREE" "$PAIR_ROOT/backend"
  [ -e "$BACKEND_WORKTREE/.venv" ] || ln -s "$BACKEND_REPO/.venv" "$BACKEND_WORKTREE/.venv"
  link_node_modules

  printf 'Matched Codex worktrees ready on %s\n' "$BRANCH"
  printf '  backend: %s\n' "$BACKEND_WORKTREE"
  printf '  card:    %s\n' "$CARD_WORKTREE"
  printf '  pair:    %s\n' "$PAIR_ROOT"
}

run_check() {
  local target="${1:-all}" level="${2:-fast}"
  setup_pair >/dev/null
  export GROWSPACE_BACKEND="$BACKEND_WORKTREE"
  export GROWSPACE_CARD="$CARD_WORKTREE"
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  export PYTHONDONTWRITEBYTECODE=1
  exec "$HUB_WORKTREE/scripts/check" "$target" "$level"
}

run_precommit() {
  setup_pair >/dev/null
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  export PYTHONDONTWRITEBYTECODE=1
  cd "$BACKEND_WORKTREE"
  exec ./.venv/bin/pre-commit run --all-files
}

run_card_precommit() {
  setup_pair >/dev/null
  export PRE_COMMIT_HOME="$PAIR_ROOT/.cache/pre-commit"
  cd "$CARD_WORKTREE"
  exec "$BACKEND_REPO/.venv/bin/pre-commit" run --all-files
}

# Point the shared dev runtime at a card dist/ and wait for it to serve again.
# scripts/ha refuses to run from a worktree — the compose file resolves ha-dev/
# and the backend mount relative to itself — so drive the main checkout's copy
# and override only the card bundle.
remount_card_dist() {
  local dist="$1" code
  GROWSPACE_CARD_DIST="$dist" "$LOCAL_HUB/scripts/ha" dev restart >/dev/null

  for _ in $(seq 1 60); do
    code="$(curl -s -o /dev/null -w '%{http_code}' \
      http://localhost:8123/local/community/lovelace-growspace-manager-card/growspace-manager-card.js 2>/dev/null || true)"
    [ "$code" = "200" ] && { printf '→ HA serving %s\n' "$dist"; return 0; }
    sleep 2
  done

  echo "ERROR: HA did not serve the card bundle from $dist within 120s" >&2
  return 1
}

run_card_e2e() {
  # The browser flow drives Vite, which writes its dep-optimiser cache into
  # node_modules/.vite. Under a plain symlink that cache is the main checkout's,
  # so two trees building at once fight over it. This is the one flow that
  # actually needs the farm's local cache directories.
  NODE_MODULES_MODE="${GROWSPACE_NODE_MODULES:-farm}"
  setup_pair >/dev/null
  [ -f "$CARD_WORKTREE/tests/e2e/.env.test" ] || {
    echo "ERROR: copy the card E2E config into $CARD_WORKTREE/tests/e2e/.env.test first" >&2
    exit 1
  }

  cd "$CARD_WORKTREE"

  # Build, then actually serve what was built. Without the remount, HA keeps
  # serving the main checkout's dist/ and the suite silently validates a bundle
  # this worktree never produced. rollup also deletes and recreates dist/, so
  # the remount has to happen after the build or Docker holds the dead inode.
  npm run build

  # The runtime is a singleton shared with the main checkout; hand it back on
  # the way out however we exit, so a failed run does not leave :8123 serving
  # this worktree's bundle.
  trap 'remount_card_dist "$CARD_REPO/dist" >/dev/null 2>&1 || true' EXIT
  remount_card_dist "$CARD_WORKTREE/dist"

  npm run test:ha
}

case "${1:-setup}" in
  setup) setup_pair ;;
  path) printf '%s\n' "$PAIR_ROOT" ;;
  check) shift; run_check "$@" ;;
  precommit) run_precommit ;;
  card-precommit) run_card_precommit ;;
  card-e2e) run_card_e2e ;;
  status)
    setup_pair >/dev/null
    git -C "$BACKEND_WORKTREE" status --short --branch
    git -C "$CARD_WORKTREE" status --short --branch
    ;;
  *)
    echo "usage: $0 {setup|path|status|precommit|card-precommit|card-e2e|check [backend|card|all] [fast|full]}" >&2
    exit 2
    ;;
esac
