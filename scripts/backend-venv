#!/usr/bin/env bash
# Safely prepare the Python environment for a backend-type worktree.
#
# The counterpart to scripts/card-node-modules, and deliberately NOT the same
# policy — see docs/adr/0002-private-backend-venvs-for-hub-managed-worktrees.md
# and docs/adr/0004-python-hooks-run-the-worktrees-own-venv.md. uv installs from
# a hardlinked content-addressed cache, so a private venv costs ~7.9 MiB and
# ~0.4 s warm. Sharing therefore buys nothing here, and costs a destructive
# write-through class npm's link does not have.
#
#   backend-venv <main-checkout> <worktree> [backend|tc]
#
# Hooks must run <worktree>/.venv. Refuse a branch with fixed-path hooks before
# touching its environment; it needs rebasing onto a base with the hook runner.
#
# The main checkout's venv matches the main checkout's own pins and nothing
# else. No path through here rebuilds it, and no message advises rebuilding it
# from a branch's pins: that is how it ended up on one branch's fpdf2 once.
set -euo pipefail

MAIN="${1:?usage: backend-venv <main-checkout> <worktree>}"
WORKTREE="${2:?usage: backend-venv <main-checkout> <worktree>}"
KIND="${3:-backend}"

MAIN="$(cd "$MAIN" && pwd)"
WORKTREE="$(cd "$WORKTREE" && pwd)"
MAIN_VENV="$MAIN/.venv"
OWN_VENV="$WORKTREE/.venv"
REQUIREMENTS="$WORKTREE/requirements.txt"
HOOK_CONFIG="$WORKTREE/.pre-commit-config.yaml"
CONSTRAINTS_PY='import homeassistant, pathlib; print(pathlib.Path(homeassistant.__file__).parent / "package_constraints.txt")'

die() {
  echo "ERROR: $*" >&2
  exit 1
}

# requirements.txt does not declare uv — it arrives as a transitive Home
# Assistant dependency, so it is present but not guaranteed to be. Borrow
# whichever binary exists; it only ever acts on the interpreter named by
# --python, so which one is irrelevant.
uv_bin() {
  local candidate
  for candidate in "$MAIN_VENV/bin/uv" "$OWN_VENV/bin/uv"; do
    [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return; }
  done
  command -v uv 2>/dev/null && return
  return 1
}

# Ask the worktree's own config because a branch may predate the hook runner.
fixed_path_hooks() {
  [ -f "$HOOK_CONFIG" ] && grep -Eq "^[[:space:]]*entry:[[:space:]]*['\"]?\.\./\.\./\.venv/bin/" "$HOOK_CONFIG"
}

# Does this environment realize these requirements?
#
# `uv pip install --dry-run --offline` is the Python integrations' answer to npm's
# `npm ci --dry-run --offline`, and a better one: it reports whether the
# INSTALLED versions satisfy the declared requirements, so loosening a pin
# passes and changing one fails. That is the question worth asking, and it
# costs ~0.1 s. There is no lockfile here to compare byte-for-byte, and after
# this check there would be no point to one.
verify_env() { # venv, requirements, quiet
  local venv="$1" requirements="$2" quiet="${3:-}" py uv constraints plan
  py="$venv/bin/python"

  [ -x "$py" ] || { [ -n "$quiet" ] || echo "ERROR: no interpreter at $py" >&2; return 1; }
  [ -f "$requirements" ] || { echo "ERROR: missing $requirements" >&2; return 1; }
  uv="$(uv_bin)" || { echo "ERROR: no uv binary to validate $venv with" >&2; return 1; }

  # The venv is built in two phases against Home Assistant's own constraints
  # (see the repositories' setup docs), so verify against them too — otherwise the
  # check asks a looser question than the install answered. An unimportable
  # homeassistant is itself drift.
  constraints="$("$py" -c "$CONSTRAINTS_PY" 2>/dev/null)" || {
    [ -n "$quiet" ] || echo "ERROR: homeassistant is not importable from $venv" >&2
    return 1
  }

  if ! plan="$("$uv" pip install --python "$py" --dry-run --offline \
      -r "$requirements" -c "$constraints" 2>&1)"; then
    [ -n "$quiet" ] || printf '%s\n' "$plan" >&2
    return 1
  fi
  # A cache hit lets uv exit 0 while still planning an install, so the exit code
  # alone is not the answer — the phrase is.
  case "$plan" in
    *"Would make no changes"*) return 0 ;;
    *) [ -n "$quiet" ] || printf '%s\n' "$plan" >&2; return 1 ;;
  esac
}

python_series() {
  local series
  series="$(sed -n 's/^requires-python *= *"[^0-9]*\([0-9]\+\.[0-9]\+\).*/\1/p' "$WORKTREE/pyproject.toml" 2>/dev/null | head -1)"
  printf '%s\n' "${series:-3.14}"
}

# uv reports installs on stderr, and a full backend environment is ~180 lines of
# it. Keep that for the failure case and say nothing on success.
quietly() {
  local log rc
  log="$(mktemp)"
  "$@" >"$log" 2>&1
  rc=$?
  [ "$rc" -eq 0 ] || cat "$log" >&2
  rm -f "$log"
  return "$rc"
}

build_private_venv() { # destination
  local dest="$1" uv series constraints
  uv="$(uv_bin)" || die "no uv binary available to build $dest"
  series="$(python_series)"

  # Never --clear an existing path: through a symlink that clears the LENDER's
  # venv, not this one. Remove our own entry first, then create.
  [ -L "$dest" ] && unlink "$dest"
  [ -e "$dest" ] && rm -rf "$dest"

  printf '→ building private %s venv (python %s) in %s\n' "$KIND" "$series" "$dest"
  quietly "$uv" venv --python "$series" "$dest" \
    || die "could not create a venv at $dest"

  # Two-phase, exactly as the Python repository setup documents: homeassistant
  # first, then everything else under the constraints it ships. One
  # unconstrained pass is what let hassil float past the pinned HA release.
  quietly "$uv" pip install --python "$dest/bin/python" \
    "$(grep '^homeassistant==' "$REQUIREMENTS")" \
    || die "could not install homeassistant into $dest"
  constraints="$("$dest/bin/python" -c "$CONSTRAINTS_PY")"
  quietly "$uv" pip install --python "$dest/bin/python" -r "$REQUIREMENTS" -c "$constraints" \
    || die "could not install $REQUIREMENTS into $dest"
}

# A private venv that is missing, is a link, or has drifted is (re)built; one
# that already realizes this branch's requirements is left alone.
ensure_private_venv() { # destination
  local dest="$1"
  if [ -L "$dest" ]; then
    printf '→ replacing the %s venv link %s -> %s with a private venv\n' \
      "$KIND" "$dest" "$(readlink "$dest")"
    build_private_venv "$dest"
  elif [ ! -x "$dest/bin/python" ]; then
    build_private_venv "$dest"
  elif ! verify_env "$dest" "$REQUIREMENTS" quiet; then
    printf '→ private %s venv at %s no longer realizes requirements.txt; rebuilding\n' "$KIND" "$dest"
    build_private_venv "$dest"
  fi
  verify_env "$dest" "$REQUIREMENTS" || die "the private venv at $dest still does not realize $REQUIREMENTS"
}

[ "$WORKTREE" != "$MAIN" ] || die "$WORKTREE is the main $KIND checkout. Its venv realizes its own requirements.txt and is built by hand — see the $KIND repo's AGENTS.md. backend-venv only prepares worktrees."
[ -f "$REQUIREMENTS" ] || die "missing worktree requirements: $REQUIREMENTS"

fixed_path_hooks && die "this branch's hooks declare \`entry: ../../.venv/bin/...\`; rebase onto a base that has the hook runner (python3 .github/scripts/run_venv_tool.py), then rerun setup"

ensure_private_venv "$OWN_VENV"
printf '→ private %s venv at %s\n' "$KIND" "$OWN_VENV"
