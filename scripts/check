#!/usr/bin/env bash
# Layered validation. Agents are told to run these exact commands — no guessing
# at venv paths, no inventing flags.
#
#   ./scripts/check backend fast     ruff + mypy + targeted pytest
#   ./scripts/check backend full     + whole pytest suite w/ coverage
#   ./scripts/check tc      fast     pytest
#   ./scripts/check tc      full     + coverage
#   ./scripts/check card    fast     eslint + tsc + prettier + tokens + vitest
#   ./scripts/check card    full     + coverage + contract fixture + build + HACS
#   ./scripts/check vision  fast     V1 contract + backend fixtures + card schemas
#   ./scripts/check vision  full     + Vision suite + two-architecture App smoke
#   ./scripts/check all     fast|full
#
# Exit code is non-zero if ANY stage fails (nothing is swallowed).
set -uo pipefail

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND="${GROWSPACE_BACKEND:-$WS/../growspace_manager}"
TC="${GROWSPACE_TC:-$WS/../growspace_manager_tc}"
CARD="${GROWSPACE_CARD:-$WS/../lovelace-growspace-manager-card}"
VISION="${GROWSPACE_VISION:-$WS/../growspace_manager_vision}"
# Normalize all of them, so every path this script prints or compares is the one a
# reader would recognize. The defaults are `$WS/../<repo>`, which never equals
# the same directory's real path as a string — and the checkout comparison below
# is a string comparison. A missing tree keeps its raw value for the report.
abspath() { (cd "$1" 2>/dev/null && pwd) || printf '%s\n' "$1"; }
BACKEND="$(abspath "$BACKEND")"
TC="$(abspath "$TC")"
CARD="$(abspath "$CARD")"
VISION="$(abspath "$VISION")"
PY="$BACKEND/.venv/bin/python"
TC_PY="$TC/.venv/bin/python"
VISION_PY="${GROWSPACE_VISION_PY:-$VISION/.venv/bin/python}"

TARGET="${1:-all}"
LEVEL="${2:-fast}"
RC=0

hdr() { printf '\n\033[1;36m━━ %s\033[0m\n' "$*"; }
refuse() {
  printf '\n\033[1;31m✗ %s\033[0m\n' "$1" >&2
  shift
  local line
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
}
run() {
  hdr "$1"; shift
  "$@" || { RC=1; printf '\033[1;31m✗ FAILED: %s\033[0m\n' "$*"; }
}

check_backend() {
  [ -x "$PY" ] || { echo "ERROR: venv missing at $PY — see the repo's CLAUDE.md" >&2; RC=1; return; }
  cd "$BACKEND"
  # Scopes below mirror .pre-commit-config.yaml exactly, so a green run here
  # means the hooks will not reject your commit:
  #   ruff-format  files: ^(custom_components|tests)/.+\.(py|pyi)$
  #   mypy         files: ^custom_components/.+\.(py|pyi)$   args: --follow-imports=silent
  #   pytest       whole suite (pass_filenames: false)
  #   ruff-check   no `files:` filter -> whole repo
  run "ruff check"  "$PY" -m ruff check .
  run "ruff format" "$PY" -m ruff format --check custom_components/ tests/
  run "mypy"        "$PY" -m mypy --follow-imports=silent custom_components/
  if [ "$LEVEL" = full ]; then
    run "pytest (full + coverage)" "$PY" -m pytest tests/ \
      --cov=custom_components.growspace_manager --cov-report=term-missing -q
  else
    run "pytest" "$PY" -m pytest tests/ -q
  fi
}

check_tc() {
  [ -x "$TC_PY" ] || { echo "ERROR: venv missing at $TC_PY — see the TC repo's AGENTS.md" >&2; RC=1; return; }
  cd "$TC"
  # Mirror the TC repository's Tests workflow: its own pytest suite, with
  # coverage in the full lane. Repository-file linting remains pre-commit's job.
  if [ "$LEVEL" = full ]; then
    run "TC pytest (full + coverage)" "$TC_PY" -m pytest tests/ \
      --cov=custom_components.growspace_manager_tc --cov-report=term-missing -q
  else
    run "TC pytest" "$TC_PY" -m pytest tests/ -q
  fi
}

check_card() {
  cd "$CARD"
  # Stages below mirror .github/workflows/lint.yml's job, in its order, so a
  # green run here means CI's lint job will not reject your PR. The card has no
  # husky/lint-staged, so nothing formats on commit — `format:check` is a real
  # gate that only CI was enforcing until it bit #750.
  run "eslint"           npm run --silent lint
  run "typecheck"        npm run --silent typecheck
  run "format:check"     npm run --silent format:check
  run "design tokens"    npm run --silent tokens:check
  run "colour literals"  npm run --silent tokens:audit -- --check
  if [ "$LEVEL" = full ]; then
    run "unit tests (coverage)" npm run --silent test:coverage
    run "contract fixture"      npm run --silent test:contract-fixture
    run "rollup build"          npm run --silent build
    # Reads dist/, so it has to follow the build.
    run "HACS release layout"   npm run --silent validate:hacs-release
  else
    run "unit tests" npm run --silent test
  fi
}

check_vision() {
  local contract_dir="$BACKEND/tests/fixtures/contract"

  cd "$VISION"
  if [ "$LEVEL" = full ]; then
    [ -x "$VISION_PY" ] || {
      refuse "no Vision test environment at $VISION_PY" \
             "set GROWSPACE_VISION_PY to the Python executable that realizes $VISION/pyproject.toml"
      RC=1
      return
    }
    run "Vision ruff check" "$VISION_PY" -m ruff check \
      src tests scripts growspace_vision
    run "Vision ruff format" "$VISION_PY" -m ruff format --check \
      src tests scripts growspace_vision
    run "Vision mypy" "$VISION_PY" -m mypy src growspace_vision scripts
    run "Vision service and contract tests" env PYTHONPATH=src \
      "$VISION_PY" -m unittest discover -s tests -v
  else
    run "Vision V1 service contract" python3 -m unittest discover \
      -s tests -p test_growspace_vision_contract.py -v
  fi

  cd "$BACKEND"
  run "backend Vision fixture handoff" "$PY" \
    tests/utils/vision_contract_fixtures.py \
    --vision-root "$VISION" --backend-root "$BACKEND"
  run "backend Vision parser boundary" "$PY" -m pytest tests/test_vision_models.py -q

  cd "$CARD"
  run "card Vision schema boundary" env \
    GSM_MAIN_GROWSPACE_FIXTURE="$contract_dir/growspace_payload.json" \
    GSM_RELEASE_GROWSPACE_FIXTURE="$contract_dir/growspace_payload.json" \
    GSM_PRERELEASE_VISION_STATUS_FIXTURE="$contract_dir/vision_status_response.json" \
    GSM_PRERELEASE_VISION_HISTORY_FIXTURE="$contract_dir/vision_history_response.json" \
    GSM_PRERELEASE_VISION_TRIGGER_FIXTURE="$contract_dir/trigger_vision_checkup_response.json" \
    npm run --silent test:contract-fixture
  run "card Vision version compatibility" \
    "$CARD/node_modules/.bin/vitest" run \
    src/slices/camera/camera.schema.test.ts --environment node

  cd "$WS"
  run "simulated Vision runtime" node --test scripts/vision-runtime.test.cjs
  if [ "$LEVEL" = full ]; then
    run "network-isolated amd64 and arm64 App images" \
      "$VISION/scripts/build-app-images.sh" all
  fi
}

check_workspace_e2e() {
  cd "$WS"
  run "workspace E2E contract tests" python3 -m unittest e2e.test_entity_coverage
  run "workspace E2E tooling tests" node --test scripts/card-node-modules.test.cjs \
    scripts/check.test.cjs \
    scripts/e2e-ensure-integration.test.cjs \
    scripts/e2e-preflight.test.cjs \
    scripts/gen-e2e-dashboards.test.cjs scripts/stamp-card-resource.test.cjs \
    scripts/tc-tooling.test.cjs scripts/vision-runtime.test.cjs \
    scripts/vision-v1-acceptance.test.cjs \
    scripts/worktree-gc.test.cjs scripts/install-hooks.test.cjs
}

# The dependency tree a card check is about to validate is not necessarily the
# one this checkout installed. A hub-managed worktree's node_modules is a single
# symlink into the main checkout's tree, and that sharing is only valid while
# both checkouts agree on their dependencies — an agreement established once, at
# worktree setup, and never re-checked afterwards. See
# docs/adr/0001-guarded-shared-card-dependencies.md.
#
# So re-run the cheap half of the setup guard here: the lockfile hash comparison
# costs milliseconds and catches drift in both directions (the worktree branch
# changed its lockfile; the main checkout reinstalled a different one). The
# offline `npm ci --dry-run` is the expensive half and stays at setup, where it
# has something new to say.
#
# This refuses; it never repairs. The hub heals in its setup paths, but deciding
# that one checkout's dependencies may back another is a property of how the
# pair was created, and a validation command has no standing to re-establish it.
guard_card_deps() {
  local modules="$CARD/node_modules" target lender ours theirs lock

  # A real directory is a private install: it answers only to its own lockfile,
  # and there is no second checkout for it to disagree with. Test the link first
  # — `-e` follows a symlink, so a dangling one reads as absent.
  if [ ! -L "$modules" ]; then
    [ -d "$modules" ] && return 0
    refuse "no card dependencies at $modules" \
           "run: (cd $CARD && npm ci)"
    return 1
  fi

  target="$(readlink -f "$modules" 2>/dev/null || true)"
  if [ -z "$target" ] || [ ! -d "$target" ]; then
    refuse "dangling card dependency link in $CARD" \
           "node_modules points at $(readlink "$modules"), which is gone" \
           "run: (cd $CARD && rm node_modules && npm ci)"
    return 1
  fi

  lender="$(dirname "$target")"
  for lock in "$CARD/package-lock.json" "$lender/package-lock.json"; do
    [ -f "$lock" ] || {
      refuse "cannot compare card dependencies: missing $lock" \
             "$CARD borrows its node_modules from $lender" \
             "run: (cd $CARD && rm node_modules && npm ci)"
      return 1
    }
  done

  ours="$(sha256sum "$CARD/package-lock.json" | cut -d" " -f1)"
  theirs="$(sha256sum "$lender/package-lock.json" | cut -d" " -f1)"
  if [ "$ours" != "$theirs" ]; then
    refuse "card dependency drift — refusing to validate $CARD" \
           "its node_modules is shared from $lender" \
           "lockfiles differ: ${ours:0:12} (this checkout) != ${theirs:0:12} (shared from)" \
           "the shared tree realizes the other lockfile, so green here would mean nothing" \
           "run: (cd $CARD && rm node_modules && npm ci)   # private install" \
           "  or: (cd $lender && npm ci)                   # if the shared tree is the stale one"
    return 1
  fi

  printf '   %-9s shared from %s (lock %s)\n' "deps:" "$lender" "${ours:0:12}"
}

# The Python environment a backend or TC check is about to run is not necessarily
# the one that branch declares. Their worktrees resolve hooks through
# `../../.venv`, and whether that venv still realizes the worktree's own
# requirements.txt is an agreement made once, at worktree setup.
# See docs/adr/0002-private-backend-venvs-for-hub-managed-worktrees.md.
#
# Unlike the card, there is no lockfile to compare byte-for-byte and no reason to
# want one: `uv pip install --dry-run --offline` answers the better question —
# do the INSTALLED versions satisfy the declared requirements — in ~0.1 s. So the
# full guard runs here, not a cheap half of it.
#
# This refuses; it never repairs. Rebuilding a venv is a decision about every
# worktree that shares it, which a validation command has no standing to make.
guard_python_venv() {
  local kind="$1" checkout="$2" venv py uv requirements constraints plan candidate

  venv="$checkout/.venv"
  py="$venv/bin/python"
  requirements="$checkout/requirements.txt"

  if [ ! -x "$py" ]; then
    refuse "no $kind venv at $venv" \
           "see the $kind repo's AGENTS.md for its environment setup"
    return 1
  fi
  [ -f "$requirements" ] || { refuse "missing $requirements"; return 1; }

  # uv is not a declared requirement — it arrives transitively via Home
  # Assistant — so do not assume this venv has one. Any binary will do; it only
  # acts on the interpreter named by --python.
  uv=""
  for candidate in "$venv/bin/uv" "$WS/../growspace_manager/.venv/bin/uv" "$(command -v uv 2>/dev/null || true)"; do
    [ -n "$candidate" ] && [ -x "$candidate" ] && { uv="$candidate"; break; }
  done
  if [ -z "$uv" ]; then
    printf '   %-9s no uv binary — skipping the environment guard\n' "!"
    return 0
  fi

  # Verify against Home Assistant's own constraints, the way the venv was built;
  # an unimportable homeassistant is itself the drift worth reporting.
  if ! constraints="$("$py" -c 'import homeassistant, pathlib; print(pathlib.Path(homeassistant.__file__).parent / "package_constraints.txt")' 2>/dev/null)"; then
    refuse "homeassistant is not importable from $venv" \
           "the venv does not realize $requirements at all" \
           "rebuild it — see the $kind repo's AGENTS.md"
    return 1
  fi

  if plan="$("$uv" pip install --python "$py" --dry-run --offline \
        -r "$requirements" -c "$constraints" 2>&1)" \
     && [ "${plan#*Would make no changes}" != "$plan" ]; then
    printf '   %-9s %s\n' "venv:" "$(readlink -f "$venv")"
    return 0
  fi

  refuse "$kind environment drift — refusing to validate $checkout" \
         "$venv does not realize $requirements" \
         "green here would describe a dependency set this branch does not declare" \
         "if this venv is shared, rebuilding it affects every worktree that runs it" \
         "rebuild — see the $kind repo's AGENTS.md, or re-run the hub setup that created this worktree"
  # uv already says exactly which requirement is unmet; relay it verbatim rather
  # than paraphrasing, but drop the interpreter preamble that is not the news.
  printf '%s\n' "$plan" | grep -v '^Using Python' | sed 's/^/  │ /' >&2
  return 1
}

case "$TARGET" in
  backend|tc|card|vision|all) ;;
  *) echo "usage: $0 {backend|tc|card|vision|all} {fast|full}" >&2; exit 2 ;;
esac
case "$LEVEL" in
  fast|full) ;;
  *) echo "usage: $0 {backend|tc|card|vision|all} {fast|full}" >&2; exit 2 ;;
esac

# Say which trees are being validated. All product roots are overridable by
# environment (codex-worktree sets them to point at a managed pair), so a green
# run only means something once you know what it was green against — an
# inherited GROWSPACE_BACKEND/GROWSPACE_TC/GROWSPACE_CARD would otherwise check a
# different checkout than the one you are sitting in.
show_tree() {
  local label="$1" path="$2" var="$3" resolved
  resolved="$(cd "$path" 2>/dev/null && pwd)" || resolved="$path  \033[1;31m(MISSING)\033[0m"
  if [ -n "${!var:-}" ]; then
    printf '   %-9s %b  \033[1;33m(%s override)\033[0m\n' "$label" "$resolved" "$var"
  else
    printf '   %-9s %b\n' "$label" "$resolved"
  fi
}

# `check` has always named the checkouts it resolved, and never whether one of
# them was behind. A tree a few commits back fails in ways that belong to nobody's
# code — a fixture helper that does not exist yet, a test file added upstream —
# and reads exactly like a regression in someone's work (#140).
#
# Measured against the remote-tracking refs already on disk. This never fetches:
# `check` is offline and fast, and the case that actually bites is a checkout
# left behind by work somebody already pulled elsewhere in this workspace.
#
# It warns and never refuses. Validating a deliberately older tree is legitimate,
# and a refusal would make the common case worse.
STALE_BASES="main prerelease dev"
STALE_SEEN=0

# Ahead/behind of HEAD against a ref, into STALE_AHEAD/STALE_BEHIND.
stale_counts() {
  local counts
  counts="$(git -C "$1" rev-list --left-right --count "HEAD...$2" 2>/dev/null)" || return 1
  read -r STALE_AHEAD STALE_BEHIND <<<"$counts"
  [ -n "${STALE_BEHIND:-}" ] || return 1
}

warn_stale_checkout() {
  local checkout="$1" branch upstream base name
  local ref="" ref_ahead=0 ref_behind=0 commits where note

  git -C "$checkout" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  branch="$(git -C "$checkout" symbolic-ref --quiet --short HEAD 2>/dev/null)" || branch=""
  upstream="$(git -C "$checkout" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || upstream=""

  if [ -n "$upstream" ]; then
    stale_counts "$checkout" "$upstream" || return 0
    ref="$upstream" ref_ahead="$STALE_AHEAD" ref_behind="$STALE_BEHIND"
  else
    # No upstream — a local branch, a detached HEAD, or a branch whose remote ref
    # is gone. Report against the nearest integration branch instead: nearest
    # meaning the one already holding the most of this HEAD, which is what makes
    # a merged feature branch read as behind rather than as work in progress.
    for name in $STALE_BASES; do
      base="origin/$name"
      git -C "$checkout" rev-parse --verify --quiet "refs/remotes/$base" >/dev/null || continue
      stale_counts "$checkout" "$base" || continue
      if [ -z "$ref" ] || [ "$STALE_AHEAD" -lt "$ref_ahead" ] ||
         { [ "$STALE_AHEAD" -eq "$ref_ahead" ] && [ "$STALE_BEHIND" -lt "$ref_behind" ]; }; then
        ref="$base" ref_ahead="$STALE_AHEAD" ref_behind="$STALE_BEHIND"
      fi
    done
  fi
  [ -n "$ref" ] && [ "$ref_behind" -gt 0 ] || return 0

  commits=commits; [ "$ref_behind" -eq 1 ] && commits=commit
  where="${branch:-detached HEAD}"
  # Say enough to tell "two commits behind origin/prerelease" — a checkout that
  # simply has not pulled — from "on a merged branch six behind origin/main".
  if [ -z "$upstream" ] && [ "$ref_ahead" -eq 0 ]; then
    note="  (no upstream — nothing of its own)"
  elif [ -z "$upstream" ]; then
    note="  (no upstream — $ref_ahead of its own)"
  elif [ "$ref_ahead" -gt 0 ]; then
    note="  ($ref_ahead ahead)"
  else
    note=""
  fi
  printf '   \033[1;33m%-9s %s is %s %s behind %s%s\033[0m\n' \
    "!" "$where" "$ref_behind" "$commits" "$ref" "$note"
  STALE_SEEN=1
}

# The same trap without the environment variable: an agent working in a
# `scripts/feature` worktree runs `./scripts/check card`, the fallback resolves
# to the MAIN checkout, and the run reports green about a tree they never
# touched. We cannot guess which one they meant — checking main from a worktree
# is legitimate — so make the mismatch impossible to miss and print the
# invocation that would validate theirs instead.
CALLER="$PWD"
warn_foreign_checkout() {
  local label="$1" resolved="$2" var="$3" here here_repo resolved_repo
  [ -z "${!var:-}" ] || return 0
  here="$(git -C "$CALLER" rev-parse --show-toplevel 2>/dev/null)" || return 0
  # rev-parse reports a physical path; compare like for like so a symlinked
  # checkout path does not read as a different tree.
  [ -n "$here" ] && [ "$here" != "$(readlink -f "$resolved")" ] || return 0
  here_repo="$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  resolved_repo="$(git -C "$resolved" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  [ "$here_repo" = "$resolved_repo" ] || return 0
  printf '   \033[1;33m%-9s you are standing in %s\033[0m\n' "!" "$here"
  printf '   %-9s a different %s checkout of the same repo — it is NOT being checked\n' "" "$label"
  printf '   %-9s to check that one:  %s=%s %s %s %s\n' "" "$var" "$here" "$0" "$TARGET" "$LEVEL"
}

# One resolved tree, fully reported: the path, whether you are standing in a
# different checkout of the same repo, and whether it is behind. `primary` marks
# the tree this target is actually about — the foreign-checkout warning only
# means something for that one.
report_tree() {
  local label="$1" path="$2" var="$3"
  show_tree "$label" "$path" "$var"
  if [ "${4:-}" = primary ]; then
    warn_foreign_checkout "${label%:}" "$path" "$var"
  fi
  warn_stale_checkout "$path"
}

printf '\033[1;36m━━ checking\033[0m %s / %s\n' "$TARGET" "$LEVEL"
case "$TARGET" in
  backend)
    report_tree backend: "$BACKEND" GROWSPACE_BACKEND primary
    # Not a stage of this target, but the E2E guard below judges this checkout's
    # committed fixture against the hub's declarations, so name it before it can
    # refuse over a tree the header never mentioned.
    report_tree card: "$CARD" GROWSPACE_CARD
    ;;
  tc)
    report_tree tc: "$TC" GROWSPACE_TC primary
    ;;
  card)
    report_tree card: "$CARD" GROWSPACE_CARD primary
    ;;
  vision)
    report_tree vision: "$VISION" GROWSPACE_VISION primary
    report_tree backend: "$BACKEND" GROWSPACE_BACKEND
    report_tree card: "$CARD" GROWSPACE_CARD
    ;;
  all)
    report_tree backend: "$BACKEND" GROWSPACE_BACKEND primary
    report_tree tc: "$TC" GROWSPACE_TC primary
    report_tree card: "$CARD" GROWSPACE_CARD primary
    report_tree vision: "$VISION" GROWSPACE_VISION primary
    ;;
esac
# Said once, however many trees warned: these counts are as old as the last
# fetch, and `check` is not the command that refreshes them.
if [ "$STALE_SEEN" -ne 0 ]; then
  printf '   %-9s behind-counts come from the refs already on disk — check never fetches\n' ""
fi

# Before any stage runs — including the backend half of `all`, which would
# otherwise spend a whole pytest suite on its way to a card refusal.
GUARDED=0
# The E2E coverage guard runs wherever `check_workspace_e2e` does, backend
# included, because the drift it catches is authored on the hub side and only
# observable on the card side: `e2e/entity_coverage.py` is the source and the
# card's committed fixture is generated from it. Guarding `card` alone meant a
# hub declaration change passed `./scripts/check backend` cleanly and then
# refused the whole card validation for whoever touched the card next — see
# lovelace-growspace-manager-card#884.
case "$TARGET" in
  backend|card|vision|all) "$WS/scripts/check-e2e-coverage" --card-root "$CARD" || GUARDED=1 ;;
esac
[ "$TARGET" != backend ] && [ "$TARGET" != vision ] && [ "$TARGET" != all ] || { guard_python_venv backend "$BACKEND" || GUARDED=1; }
[ "$TARGET" != tc ] && [ "$TARGET" != all ] || { guard_python_venv tc "$TC" || GUARDED=1; }
[ "$TARGET" != card ] && [ "$TARGET" != vision ] && [ "$TARGET" != all ] || { guard_card_deps || GUARDED=1; }
if [ "$GUARDED" -ne 0 ]; then
  printf '\n\033[1;31m✗ %s / %s — refusing to run\033[0m\n' "$TARGET" "$LEVEL"
  exit 1
fi

case "$TARGET" in
  backend) check_workspace_e2e; check_backend ;;
  tc)      check_tc ;;
  card)    check_workspace_e2e; check_card ;;
  vision)  check_vision ;;
  all)
    check_workspace_e2e
    check_vision
    check_backend
    check_tc
    check_card
    ;;
esac

if [ $RC -eq 0 ]; then
  printf '\n\033[1;32m✓ %s / %s — all checks passed\033[0m\n' "$TARGET" "$LEVEL"
else
  printf '\n\033[1;31m✗ %s / %s — one or more checks FAILED\033[0m\n' "$TARGET" "$LEVEL"
fi
exit $RC
