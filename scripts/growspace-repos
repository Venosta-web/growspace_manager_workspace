#!/usr/bin/env bash
# Where the hub's tooling finds things — the one implementation. Every hub
# script, shell, Node or Python, asks this rather than working it out itself.
#
#   growspace-repos               every sibling product repository that exists,
#                                 plus the hub itself: `name<TAB>path` per line
#   growspace-repos --hub         the main hub checkout
#   growspace-repos <repo>        where sibling <repo> lives, printed whether or
#                                 not it exists — reporting a missing checkout
#                                 is the caller's business
#
# Siblings hang off the MAIN hub checkout rather than off this script's parent.
# Run from a hub worktree — `.claude/worktrees/<name>`, `worktrees/<name>` — and
# `..` is a directory of worktrees, where no repository lives.
#
# A hub that is not a git checkout at all (a copied tree, a test fixture) is its
# own main checkout, so its siblings are simply `..` again.
set -euo pipefail

REPOS=(growspace_manager growspace_manager_tc growspace_manager_vision
       lovelace-growspace-manager-card)

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
HUB="$WS"
if common="$(git -C "$WS" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  HUB="$(cd "$(dirname "$common")" && pwd -P)"
fi
DEV_ROOT="$(dirname "$HUB")"

case "${1:-}" in
  "")
    for name in "${REPOS[@]}"; do
      if [ -d "$DEV_ROOT/$name/.git" ]; then
        printf '%s\t%s\n' "$name" "$(cd "$DEV_ROOT/$name" && pwd -P)"
      fi
    done
    printf '%s\t%s\n' "$(basename "$HUB")" "$HUB"
    ;;
  --hub)
    printf '%s\n' "$HUB"
    ;;
  *)
    for name in "${REPOS[@]}"; do
      if [ "$1" = "$name" ]; then
        if [ -d "$DEV_ROOT/$name" ]; then
          (cd "$DEV_ROOT/$name" && pwd -P)
        else
          printf '%s\n' "$DEV_ROOT/$name"
        fi
        exit 0
      fi
    done
    echo "growspace-repos: unknown repository '$1' (known: ${REPOS[*]})" >&2
    exit 2
    ;;
esac
