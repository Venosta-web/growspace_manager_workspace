#!/usr/bin/env python3
"""
Seed the dev instance's Tissue Culture world, so the TC dialog opens onto work.

  ./scripts/seed-tc-world            # media, lines, cultures, history, pairings
  ./scripts/seed-tc-world --clear    # remove what this seeded
  ./scripts/seed-tc-world --report   # say what the store holds, change nothing

A fresh install of Growspace Manager TC is functional and empty, so the dialog
opens onto "Nothing is due. Every vessel still has time on the medium it is on."
— the same screen an install with a full bench would show if nothing happened to
be due, and therefore the one screen a demo must not land on.

**This writes the store directly, and drives TC's own models to build it.**
`MaintenanceAction.recorded()` takes an optional `now`, but no TC WebSocket
schema exposes `recorded_at` and no handler passes one: every act an API-driven
seed could record would be stamped today, every Replate Due Date would land at
today plus its interval, and the Worklist would still be empty — the same empty
screen, with ninety days of history behind it. So the calendar is the one thing
invented here. Everything else — the Medium Version a Plating pins, the Replate
Due Date, what a division does to a Culture's identity, which acts an ended
vessel refuses — comes from the integration's own models and repository, imported
out of the TC checkout. They cannot drift from the shipped rules without this
script failing loudly, which is the same bargain `seed-vision-history` strikes
with the Vision evidence schema.

**Home Assistant holds this state in memory and saves over the file.** Seed with
it down, or restart it afterwards; the script says which of the two applies on
the run you just did.

Prerequisites: the growspace_manager_tc checkout (`GROWSPACE_TC` to select
another), and a strain library holding the phenotypes the Culture Lines
reference — `./scripts/seed-demo` puts them there. Home Assistant need not be
running, and the TC integration need not be set up: the store is a plain host
file, and an entry added later loads it.
"""

from __future__ import annotations

import argparse
import importlib
import json
import os
import pathlib
import sqlite3
import subprocess
import sys
import types
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta

# --------------------------------------------------------------------------
# checkouts
#
# The runtime belongs to the MAIN hub checkout: ha-dev/ is bind-mounted from
# beside docker-compose.yml, so its store is the one Home Assistant reads
# whichever checkout this script was invoked from. The models, in contrast, are
# code — those come from the TC checkout, so a worktree exercises its branch.
# --------------------------------------------------------------------------
HERE = pathlib.Path(__file__).resolve().parent.parent


def main_hub_checkout() -> pathlib.Path:
    """Return the main hub checkout, even when run from one of its worktrees."""
    try:
        common = subprocess.run(
            [
                "git",
                "-C",
                str(HERE),
                "rev-parse",
                "--path-format=absolute",
                "--git-common-dir",
            ],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return HERE
    return pathlib.Path(common).parent.resolve()


WORKSPACE = main_hub_checkout()
HA_DEV = WORKSPACE / "ha-dev"
STORAGE = HA_DEV / ".storage"
STRAIN_LIBRARY = HA_DEV / "strain_library.db"

TC = pathlib.Path(
    os.environ.get("GROWSPACE_TC", WORKSPACE / ".." / "growspace_manager_tc")
).resolve()

HA_URL = os.environ.get("HA_BASE_URL", "http://127.0.0.1:8123")


def die(message: str) -> None:
    """Exit with a message on stderr."""
    sys.exit(f"error: {message}")


# --------------------------------------------------------------------------
# imported implementations — nothing below is reimplemented here
# --------------------------------------------------------------------------
def load_tc():
    """Import TC's constants, models and repository from the TC checkout.

    `custom_components.growspace_manager_tc.__init__` imports Home Assistant,
    which is not on this interpreter's path and has no business being — the
    models and the repository are pure by design, so that the rules can be
    argued with without a `hass`. The package chain is therefore registered as
    bare namespace modules pointing at the real directories and only the leaves
    are executed; they import each other by absolute name and resolve through
    those `__path__` entries exactly as they would inside Home Assistant.
    """
    root = TC / "custom_components" / "growspace_manager_tc"
    if not root.is_dir():
        die(f"no TC integration at {TC} (set GROWSPACE_TC)")

    packages = {
        "custom_components": TC / "custom_components",
        "custom_components.growspace_manager_tc": root,
        "custom_components.growspace_manager_tc.models": root / "models",
        "custom_components.growspace_manager_tc.data_access": root / "data_access",
    }
    for name, path in packages.items():
        if name in sys.modules:
            continue
        package = types.ModuleType(name)
        package.__path__ = [str(path)]
        package.__package__ = name
        sys.modules[name] = package

    try:
        leaves = [
            importlib.import_module(f"custom_components.growspace_manager_tc.{name}")
            for name in (
                "const",
                "models.common",
                "models.culture_line",
                "models.culture_medium",
                "data_access.culture_repository",
            )
        ]
    except (ImportError, SyntaxError) as error:
        die(
            f"cannot import TC's models from {TC}: {error}\n"
            f"       (this interpreter is Python {sys.version_info.major}."
            f"{sys.version_info.minor}; the integration targets 3.14)"
        )
    return tuple(leaves)


CONST, COMMON, LINE_MODEL, MEDIUM_MODEL, REPOSITORY = load_tc()

STORE = STORAGE / CONST.STORAGE_KEY
COLLECTIONS = (
    CONST.COLLECTION_CULTURE_MEDIA,
    CONST.COLLECTION_CULTURE_LINES,
    CONST.COLLECTION_CULTURES,
    CONST.COLLECTION_MAINTENANCE_ACTIONS,
    CONST.COLLECTION_PAIRINGS,
)


# --------------------------------------------------------------------------
# the calendar — the one thing this script invents
#
# Every stamp is a whole number of days before today at the same hour, so the
# bench reads the same on any day it is seeded and a vessel that is meant to be
# four days overdue is four days overdue whenever you look.
# --------------------------------------------------------------------------
EPOCH = datetime.now(UTC).replace(hour=9, minute=0, second=0, microsecond=0)


def stamp(days_ago: int) -> str:
    """Return the ISO instant `days_ago` days before this morning."""
    return (EPOCH - timedelta(days=days_ago)).isoformat()


# --------------------------------------------------------------------------
# the bench
# --------------------------------------------------------------------------
SHELF_A = "Shelf A"
SHELF_B = "Shelf B"
SHELF_C = "Shelf C"
GROWTH_ROOM = "Growth room 2"
ROOTING_CABINET = "Rooting cabinet"


def component(name: str, amount: float, unit: str) -> dict[str, object]:
    """One additive or hormone entry, as the model validates it."""
    return {"name": name, "amount": amount, "unit": unit}


VITAMINS = (
    component("myo-inositol", 100.0, "mg/L"),
    component("thiamine-HCl", 0.4, "mg/L"),
)


@dataclass(frozen=True)
class Medium:
    """One Culture Medium, and the edit that forked its second version.

    `revision` is a formulation and the day it was saved. Whether that produces
    a Medium Version is `CultureMedium.edited`'s decision, not this script's —
    which is exactly why the demo's version history is worth showing.
    """

    name: str
    created_days_ago: int
    formulation: dict[str, object]
    revision: tuple[int, dict[str, object]] | None = None


