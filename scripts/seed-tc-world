# --------------------------------------------------------------------------
# declarations, cross-checked
# --------------------------------------------------------------------------
MEDIUM_NAMES = {medium.name for medium in MEDIA}
LINES_BY_KEY = {line.key: line for line in LINES}
PHENOTYPE_IDS = {line.phenotype_id for line in LINES}
GRADUATIONS = tuple(act for act in HISTORY if act.kind == "graduate")


def check_declarations() -> None:
    """Refuse a world that cannot be built before touching anything."""
    if len(LINES_BY_KEY) != len(LINES):
        die("two culture lines share a key")
    if len(PHENOTYPE_IDS) != len(LINES):
        die("two culture lines reference the same phenotype")
    for act in HISTORY:
        if act.line not in LINES_BY_KEY:
            die(f"the history acts on an undeclared line {act.line!r}")
        if act.medium and act.medium not in MEDIUM_NAMES:
            die(f"the history plates onto an undeclared medium {act.medium!r}")
        if act.plant is not None and act.kind != "graduate":
            die(f"only a graduation creates a plant, and {act.kind!r} is not one")
    # The two halves of the bridge, each of which has to be exactly one: a demo
    # that shows two linked graduations shows the same thing twice, and one that
    # shows none has lost the only act crossing back into Growspace Manager.
    linked = [act for act in GRADUATIONS if act.plant is not None]
    if len(linked) != 1:
        die(f"the history declares {len(linked)} graduations with a plant, not one")
    if len(GRADUATIONS) - len(linked) != 1:
        die(
            f"the history declares {len(GRADUATIONS) - len(linked)} graduations"
            " without a plant, not one"
        )
    for endorsement in PAIRINGS:
        if endorsement.line not in LINES_BY_KEY:
            die(f"a pairing endorses an undeclared line {endorsement.line!r}")
        if endorsement.medium not in MEDIUM_NAMES:
            die(f"a pairing endorses an undeclared medium {endorsement.medium!r}")


def check_strain_library() -> dict[str, tuple[str, str]]:
    """Refuse a bench whose names would all read as missing, and return the join.

    Six of the seven lines exist so the audience recognises the names off the
    tent, and a run before `./scripts/seed-demo` has filled the library would
    produce seven Missing Phenotypes instead — a demo of the failure state.

    The seventh is checked the other way round. If the demo roster ever grows
    the strain this line references, the Missing Phenotype quietly resolves and
    the one TC state that has to be constructed on purpose is gone; better to
    fail here than to discover it on stage.

    What comes back is the library keyed by Phenotype Reference, which is the
    same lookup the card's graduation form does to fill in a graduating vessel's
    genetics — the reference stays opaque, and Growspace Manager's own row says
    what strain and phenotype it names.
    """
    if not STRAIN_LIBRARY.exists():
        die(
            f"no strain library at {STRAIN_LIBRARY}\n"
            "       seed the tent first: ./scripts/seed-demo"
        )
    connection = sqlite3.connect(f"file:{STRAIN_LIBRARY}?mode=ro", uri=True)
    try:
        library = {
            f"{strain}|{phenotype}": (
                strain,
                # `default` is how the library spells "this strain has no
                # phenotypes", and a plant carrying it as one would read as a
                # phenotype called default. The card drops it here too.
                "" if phenotype == "default" else phenotype,
            )
            for strain, phenotype in connection.execute(
                "SELECT s.strain_name, p.phenotype_name FROM phenotypes p"
                " JOIN strains s ON s.strain_id = p.strain_id"
            )
        }
        known = set(library)
    except sqlite3.DatabaseError as error:
        die(f"cannot read the strain library at {STRAIN_LIBRARY}: {error}")
    finally:
        connection.close()

    missing = sorted(
        line.phenotype_id
        for line in LINES
        if line.resolves and line.phenotype_id not in known
    )
    if missing:
        die(
            "the strain library does not hold the phenotypes these culture lines"
            f" reference: {', '.join(missing)}\n"
            "       seed the tent first: ./scripts/seed-demo"
        )
    resolved = sorted(
        line.phenotype_id
        for line in LINES
        if not line.resolves and line.phenotype_id in known
    )
    if resolved:
        die(
            f"the strain library now holds {', '.join(resolved)}, which this script"
            " keeps unresolvable on purpose so the demo can show a Missing"
            " Phenotype;\n       point that line at a phenotype nobody grows, or"
            " drop the strain from the roster"
        )
    return library


# --------------------------------------------------------------------------
# building the world through TC's own repository
# --------------------------------------------------------------------------
@dataclass
class Built:
    """What one build produced, for the report."""

    media: dict[str, object] = field(default_factory=dict)
    versions: int = 0
    lines: dict[str, object] = field(default_factory=dict)
    vessels: dict[str, list[object]] = field(default_factory=dict)
    actions: int = 0
    pairings: int = 0
    # Every Graduation as recorded, beside the act that asked for it, because
    # the bridge that follows needs both: the plant the act declares, and the
    # recorded instant the plant's clone-start has to match.
    graduations: list[tuple[Act, object]] = field(default_factory=list)


def version_in_force(medium, at: str) -> int:
    """Return the Medium Version a Plating at `at` would have pinned.

    Derived from the medium's own history rather than chosen, so a Replate
    recorded before an edit pins what was actually poured — which is the whole
    reason Medium Versions are immutable (TC ADR-0004).
    """
    for version in reversed(medium.versions):
        if version.created_at <= at:
            return version.version
    return medium.versions[0].version


def build(repository) -> Built:
    """Write the whole bench into `repository`, oldest act first."""
    built = Built()

    for medium in MEDIA:
        record = repository.create_culture_medium(
            MEDIUM_MODEL.validate_medium_name(medium.name),
            MEDIUM_MODEL.MediumFormulation.from_payload(medium.formulation),
            now=stamp(medium.created_days_ago),
        )
        if medium.revision is not None:
            days_ago, formulation = medium.revision
            record = repository.update_culture_medium(
                record.id,
                record.name,
                MEDIUM_MODEL.MediumFormulation.from_payload(formulation),
                now=stamp(days_ago),
            )
        built.media[medium.name] = record
        built.versions += len(record.versions)

    for line in LINES:
        introduced = stamp(line.introduced_days_ago)
        record, culture = repository.introduce_culture_line(
            LINE_MODEL.PhenotypeReference.taken(
                line.phenotype_id, line.phenotype_name, now=introduced
            ),
            LINE_MODEL.ReplateIntervals.from_payload(
                {"multiplication": line.multiplication, "rooting": line.rooting}
            ),
            stage=LINE_MODEL.CultureStage.MULTIPLICATION.value,
            plantlet_count=line.plantlet_count,
            location=line.location,
            now=introduced,
        )
        built.lines[line.key] = record
        built.vessels[line.key] = [culture]

    for act in sorted(HISTORY, key=lambda entry: -entry.days_ago):
        at = stamp(act.days_ago)
        vessels = built.vessels[act.line]
        if act.vessel >= len(vessels):
            die(
                f"the history plates {act.line} vessel {act.vessel} {act.days_ago} days"
                " ago, before any act had created it"
            )
        culture_id = vessels[act.vessel].id

        if act.kind == "replate":
            medium = built.media[act.medium]
            action = repository.replate_culture(
                culture_id,
                medium.id,
                version_in_force(medium, at),
                [
                    {"plantlet_count": count, "location": location}
                    for count, location in act.vessels
                ],
                note=act.note,
                now=at,
            )
            # The first vessel is the Culture that was replated — its identity
            # survives the transfer — and every further one is new to the line.
            vessels[act.vessel] = repository.culture(action.vessels[0].culture_id)
            vessels.extend(
                repository.culture(vessel.culture_id) for vessel in action.vessels[1:]
            )
        elif act.kind == "note":
            repository.note_on_culture(culture_id, act.note, now=at)
        elif act.kind == "move_to_rooting":
            repository.move_culture_to_rooting(culture_id, note=act.note, now=at)
            vessels[act.vessel] = repository.culture(culture_id)
        elif act.kind == "discard":
            repository.discard_culture(culture_id, act.reason, note=act.note, now=at)
            vessels[act.vessel] = repository.culture(culture_id)
        elif act.kind == "graduate":
            action = repository.graduate_culture(culture_id, note=act.note, now=at)
            vessels[act.vessel] = repository.culture(culture_id)
            built.graduations.append((act, action))
        else:
            die(f"the history carries an act this script cannot record: {act.kind!r}")
        built.actions += 1

    for endorsement in PAIRINGS:
        line = LINES_BY_KEY[endorsement.line]
        repository.save_pairing(
            {
                "phenotype_id": line.phenotype_id,
                "phenotype_name": line.phenotype_name,
                "medium_id": built.media[endorsement.medium].id,
                "notes": endorsement.notes,
            },
            now=stamp(endorsement.days_ago),
        )
        built.pairings += 1

    return built


# --------------------------------------------------------------------------
# the store — a plain host file, written the way Home Assistant writes it
# --------------------------------------------------------------------------
def read_store() -> tuple[dict, dict]:
    """Return the store's envelope and its data, both empty if there is none."""
    envelope = {
        "version": CONST.STORAGE_VERSION,
        "minor_version": 1,
        "key": CONST.STORAGE_KEY,
        "data": {},
    }
    if not STORE.exists():
        return envelope, {}
    try:
        stored = json.loads(STORE.read_text())
    except (OSError, ValueError) as error:
        die(f"cannot read {STORE}: {error}")
    if not isinstance(stored, dict) or not isinstance(stored.get("data"), dict):
        die(f"{STORE} is not a Home Assistant store; move it aside and rerun")
    envelope.update({key: value for key, value in stored.items() if key != "data"})
    return envelope, stored["data"]


def write_store(envelope: dict, data: dict) -> None:
    """Write the store atomically, so a reader never sees half of it."""
    STORAGE.mkdir(parents=True, exist_ok=True)
    temporary = STORE.with_suffix(STORE.suffix + ".seeding")
    temporary.write_text(json.dumps({**envelope, "data": data}, indent=2))
    os.replace(temporary, STORE)


def records(data: dict, collection: str) -> dict:
    """Return one collection from the store, empty if it is not there or not one."""
    held = data.get(collection)
    return held if isinstance(held, dict) else {}


def reference_id(row: object, field_name: str) -> str | None:
    """Return a nested phenotype reference's ID, or None."""
    if not isinstance(row, dict):
        return None
    reference = row.get(field_name)
    return reference.get("id") if isinstance(reference, dict) else None


def seeded(data: dict) -> dict[str, set[str]]:
    """Return the record IDs in the store that this script wrote.

    Recognised by declaration rather than by a marker of its own, the way
    `seed-demo` recognises its plants: a medium this script named, a line
    pointing at a phenotype it references, and everything hanging off such a
    line. A medium somebody mixed by hand, a line they introduced from the
    card, and the whole history of both are therefore left alone by `--clear`
    and are never counted as this script's.
    """
    media = {
        medium_id
        for medium_id, row in records(data, CONST.COLLECTION_CULTURE_MEDIA).items()
        if isinstance(row, dict) and row.get("name") in MEDIUM_NAMES
    }
    lines = {
        line_id
        for line_id, row in records(data, CONST.COLLECTION_CULTURE_LINES).items()
        if reference_id(row, "phenotype") in PHENOTYPE_IDS
    }
    return {
        CONST.COLLECTION_CULTURE_MEDIA: media,
        CONST.COLLECTION_CULTURE_LINES: lines,
        CONST.COLLECTION_CULTURES: {
            culture_id
            for culture_id, row in records(data, CONST.COLLECTION_CULTURES).items()
            if isinstance(row, dict) and row.get("line_id") in lines
        },
        CONST.COLLECTION_MAINTENANCE_ACTIONS: {
            action_id
            for action_id, row in records(
                data, CONST.COLLECTION_MAINTENANCE_ACTIONS
            ).items()
            if isinstance(row, dict) and row.get("line_id") in lines
        },
        CONST.COLLECTION_PAIRINGS: {
            pairing_id
            for pairing_id, row in records(data, CONST.COLLECTION_PAIRINGS).items()
            if reference_id(row, "phenotype") in PHENOTYPE_IDS
            and isinstance(row, dict)
            and row.get("medium_id") in media
        },
    }


def graduations_in(data: dict, found: dict[str, set[str]]) -> tuple[int, list[str]]:
    """Return this script's Graduations in the store, and the plants they name.

    Read off the acts rather than derived from the declaration, because the
    link is the fact: a plant this script created and then lost track of is
    still named by the graduation that created it.
    """
    graduations = [
        row
        for action_id, row in records(
            data, CONST.COLLECTION_MAINTENANCE_ACTIONS
        ).items()
        if action_id in found[CONST.COLLECTION_MAINTENANCE_ACTIONS]
        and isinstance(row, dict)
        and row.get("action") == "graduate"
    ]
    return len(graduations), [
        str(row["plant_id"]) for row in graduations if row.get("plant_id")
    ]


def drop(data: dict, found: dict[str, set[str]]) -> int:
    """Remove the given IDs from the store's collections, in place.

    Done to the persisted dictionary rather than through the repository on
    purpose: Maintenance Actions are append-only by design and the repository
    has no method that removes one, which is a rule about the product's history
    and not about a demo's scaffolding.
    """
    removed = 0
    for collection, identifiers in found.items():
        held = data.get(collection)
        if not isinstance(held, dict):
            continue
        for identifier in identifiers:
            held.pop(identifier, None)
            removed += 1
    return removed


# --------------------------------------------------------------------------
# Growspace Manager, the other side of the bridge
#
# The only part of this script that goes through Home Assistant rather than
# around it, and it has to: a plant is Growspace Manager's record, and writing
# one behind its back would give it no entity, no timeline and no stage
# arithmetic. So the plant is created by the same public service TC's own
# bridge calls, with the same `clone_start`, and its returned ID is what the
# Graduation is linked to.
# --------------------------------------------------------------------------
def read_token() -> str:
    """Read the long-lived token the same way `seed-demo` does."""
    token = os.environ.get("HA_ACCESS_TOKEN", "")
    if token:
        return token.strip()
    if not TOKEN_FILE.exists():
        die(
            f"{TOKEN_FILE} not found — create one with ./scripts/ha dev token,\n"
            "       or seed the bench alone with --no-graduated-plant"
        )
    token = TOKEN_FILE.read_text().strip()
    if not token:
        die(f"{TOKEN_FILE} is empty — create one with ./scripts/ha dev token")
    return token


@dataclass(frozen=True)
class StandingPlant:
    """One plant already in a growspace, as its own entity reports it."""

    plant_id: str
    row: int
    col: int
    strain: str
    clone_start: str


class GrowspaceManager:
    """The running instance's Growspace Manager, over its REST API."""

    def __init__(self, base_url: str, token: str) -> None:
        """Hold the endpoint and the long-lived token."""
        self._base_url = base_url.rstrip("/")
        self._token = token

    def _request(self, method: str, path: str, payload: dict | None = None) -> object:
        request = urllib.request.Request(
            f"{self._base_url}{path}",
            method=method,
            data=None if payload is None else json.dumps(payload).encode(),
            headers={
                "Authorization": f"Bearer {self._token}",
                "Content-Type": "application/json",
            },
        )
        with urllib.request.urlopen(request, timeout=60) as response:
            body = response.read()
        return json.loads(body) if body else None

    def connect(self) -> None:
        """Fail early and legibly rather than half way through the bridge."""
        try:
            self._request("GET", "/api/")
        except urllib.error.HTTPError as error:
            die(
                f"Home Assistant rejected the token from {TOKEN_FILE}: {error}\n"
                "       mint a new one with ./scripts/ha dev token"
            )
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            die(
                f"Home Assistant is not reachable at {self._base_url}: {error}\n"
                "       start it with ./scripts/ha dev up, or seed the bench alone"
                " with --no-graduated-plant"
            )
        services = self._request("GET", "/api/services")
        if not any(row.get("domain") == "growspace_manager" for row in services):
            die(
                "the growspace_manager integration is not set up on this instance;"
                " run ./scripts/e2e provision"
            )

    def states(self) -> list[dict]:
        """Every entity state, with attributes.

        `/api/states` rather than the plant store, for the reason `seed-demo`
        reads it: Home Assistant flushes that file ten seconds late, and a plant
        this script created moments ago would not be in it yet.
        """
        return self._request("GET", "/api/states")

    def add_plant(self, payload: dict) -> str:
        """Create one plant and return its ID, as the graduation bridge does."""
        try:
            response = self._request(
                "POST",
                "/api/services/growspace_manager/add_plant?return_response",
                payload,
            )
        except urllib.error.HTTPError as error:
            detail = error.read().decode(errors="replace").strip()
            die(f"growspace_manager.add_plant failed: {error} {detail}")
        plant_id = (response or {}).get("service_response", {}).get("plant_id")
        if not plant_id:
            die(f"growspace_manager.add_plant returned no plant: {response!r}")
        return str(plant_id)

    def update_plant(self, payload: dict) -> None:
        """Change one plant, which the bridge does only to a date it owns."""
        try:
            self._request(
                "POST", "/api/services/growspace_manager/update_plant", payload
            )
        except urllib.error.HTTPError as error:
            detail = error.read().decode(errors="replace").strip()
            die(f"growspace_manager.update_plant failed: {error} {detail}")

    def remove_plant(self, plant_id: str) -> None:
        """Remove one plant, tolerating one that is already gone."""
        try:
            self._request(
                "POST",
                "/api/services/growspace_manager/remove_plant",
                {"plant_id": plant_id},
            )
        except urllib.error.HTTPError as error:
            detail = error.read().decode(errors="replace").strip()
            print(f"    plant {plant_id} could not be removed: {error} {detail}")


def read_plants(states: list[dict], growspace_id: str) -> list[StandingPlant]:
    """Every plant in one growspace. A plant state is one carrying a plant_id."""
    standing = []
    for state in states:
        attributes = state["attributes"]
        if not attributes.get("plant_id"):
            continue
        if attributes.get("growspace_id") != growspace_id:
            continue
        standing.append(
            StandingPlant(
                attributes["plant_id"],
                int(attributes.get("row", 0)),
                int(attributes.get("col", 0)),
                str(attributes.get("strain", "")),
                str(attributes.get("clone_start", "") or ""),
            )
        )
    return standing


def check_growspace(states: list[dict], growspace_id: str) -> None:
    """Refuse a graduation into a growspace the instance does not have."""
    for state in states:
        identity = state["attributes"].get("identity")
        if isinstance(identity, dict) and identity.get("growspace_id") == growspace_id:
            return
    die(
        f"this instance has no {growspace_id!r} growspace for a graduate to land in;"
        "\n       run ./scripts/e2e provision, or seed the bench alone with"
        " --no-graduated-plant"
    )


def graduated_plant(
    states: list[dict], planting: Planting, strain: str
) -> StandingPlant | None:
    """Return the plant already standing where a Graduation puts one, or None.

    The same recognition `seed-demo` uses — a declared position under that
    position's declared strain is this script's — and it is what makes a second
    run place no duplicate. It matters beyond a plain rerun: Home Assistant
    saves the TC store over this script's work if it is not restarted, and the
    rerun that follows would otherwise graduate into a second plant.

    A position held by something else is refused rather than worked around,
    because `add_plant` silently relocates to the next free cell and a demo
    whose graduate wanders is worse than one that says why it stopped.
    """
    for plant in read_plants(states, planting.growspace):
        if (plant.row, plant.col) != (planting.row, planting.col):
            continue
        if plant.strain != strain:
            die(
                f"({planting.row},{planting.col}) in the {planting.growspace!r}"
                f" growspace holds {plant.strain!r} rather than the {strain!r} this"
                " graduation plants there;\n       move it, or point the graduation"
                " at a free position"
            )
        return plant
    return None


@dataclass(frozen=True)
class Bridged:
    """The plant one Graduation ended up linked to, and how it got there."""

    planting: Planting
    plant_id: str
    how: str


def cross_the_bridge(
    repository, gm: GrowspaceManager, built: Built, library: dict
) -> Bridged | None:
    """Create the graduated plant and link it, in the order TC does.

    The ending is already recorded in `repository` when this runs, exactly as
    `websocket_graduate` saves it before calling the service — so a failure here
    is the failure TC survives, and the unlinked graduation beside this one is
    what it leaves behind.
    """
    states = gm.states()
    for act, action in built.graduations:
        if act.plant is None:
            continue
        check_growspace(states, act.plant.growspace)
        strain, phenotype = library[LINES_BY_KEY[act.line].phenotype_id]
        standing = graduated_plant(states, act.plant, strain)
        if standing is None:
            plant_id = gm.add_plant(
                {
                    "growspace_id": act.plant.growspace,
                    "strain": strain,
                    "phenotype": phenotype,
                    "row": act.plant.row,
                    "col": act.plant.col,
                    # The one field the bridge adds for itself: a graduate's
                    # clone-start is the instant its Graduation was recorded.
                    "clone_start": action.recorded_at,
                }
            )
            how = "planted at"
        else:
            plant_id = standing.plant_id
            how = "adopted the plant already standing at"
            if standing.clone_start != action.recorded_at:
                # The calendar moved under a plant that outlived its graduation
                # — a store Home Assistant saved over, reseeded on a later day.
                # The link is only honest if the date it implies is.
                gm.update_plant(
                    {"plant_id": plant_id, "clone_start": action.recorded_at}
                )
                how = "corrected the clone-start of the plant standing at"
        repository.link_graduated_plant(action.id, plant_id)
        return Bridged(act.plant, plant_id, how)
    return None


# --------------------------------------------------------------------------
# Home Assistant, which holds this store in memory whatever is written here
# --------------------------------------------------------------------------
def home_assistant_is_up() -> bool:
    """Whether something is answering as Home Assistant on the dev port."""
    try:
        with urllib.request.urlopen(f"{HA_URL}/api/", timeout=5):
            return True
    except urllib.error.HTTPError:
        # 401 without a token is Home Assistant answering, which is the question.
        return True
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def report_liveness() -> None:
    """State which of the two restart requirements applies to this run."""
    print()
    if not home_assistant_is_up():
        print(f"  Home Assistant is not running at {HA_URL}.")
        print("  It reads this store on its next start; nothing further is needed.")
        return
    print("  ! Home Assistant IS RUNNING, and Growspace Manager TC holds this state")
    print("    in memory and saves over the file. Restart it before you demo:")
    print()
    print("      ./scripts/ha dev restart          # from the main hub checkout")
    print()
    print("    Until then the running instance still shows the empty bench, and the")
    print("    next TC command it serves would write that emptiness back over this.")


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------
def plural(count: int, noun: str) -> str:
    """Render a count with its noun, so a report of one reads like English."""
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def describe(found: dict[str, set[str]]) -> str:
    """Render what the store holds of this script's, collection by collection."""
    return ", ".join(
        f"{len(found[collection])} {collection.replace('_', ' ')}"
        for collection in COLLECTIONS
    )


def describe_graduates(graduations: int, planted: list[str]) -> str:
    """Render both halves of the bridge as the store has them."""
    if not graduations:
        return "none"
    return (
        f"{plural(graduations, 'graduation')}, {len(planted)} linked to a plant"
        f"{''.join(f' ({plant})' for plant in planted)}"
    )


def report_bridge(bridged: Bridged | None) -> str:
    """Render what this run's bridge did, for the seeding summary."""
    if bridged is None:
        return "no plant created (--no-graduated-plant); both graduations are unlinked"
    return (
        f"1 linked, {bridged.how} ({bridged.planting.row},{bridged.planting.col})"
        f" in {bridged.planting.growspace!r} — {bridged.plant_id};  1 unlinked"
    )


def clear_graduated_plants(planted: list[str], skipped: bool) -> None:
    """Take the graduated plants back out of Growspace Manager.

    Unlike seeding, this degrades rather than refusing: the bench is already
    gone from the store by the time it runs, and an instance that happens to be
    down is no reason to leave the rest in place. What it will not do is stay
    quiet about a plant it could not reach.
    """
    if not planted:
        return
    if skipped or not home_assistant_is_up():
        print(f"  {plural(len(planted), 'graduated plant')} left in Growspace Manager:")
        for plant_id in planted:
            print(f"    {plant_id}")
        print("    remove them with the running instance, or by hand in the card")
        return
    gm = GrowspaceManager(HA_URL, read_token())
    gm.connect()
    for plant_id in planted:
        gm.remove_plant(plant_id)
    print(f"  removed {plural(len(planted), 'graduated plant')}")


def parse_args(argv):
    """Parse the command line."""
    parser = argparse.ArgumentParser(
        description="Seed the dev instance's Tissue Culture world.",
    )
    parser.add_argument(
        "--clear", action="store_true", help="remove what this seeded, and exit"
    )
    parser.add_argument(
        "--report",
        action="store_true",
        help="say what the store holds of this script's, and exit",
    )
    parser.add_argument(
        "--no-graduated-plant",
        action="store_true",
        help=(
            "do not cross into Growspace Manager: seed both graduations unlinked,"
            " and ask nothing of Home Assistant"
        ),
    )
    return parser.parse_args(argv)


def main(argv) -> int:
    """Seed, clear or report."""
    args = parse_args(argv)
    check_declarations()

    print(f"  workspace: {WORKSPACE}")
    print(f"  tc:        {TC}")
    print(f"  store:     {STORE}")

    envelope, data = read_store()
    found = seeded(data)

    graduations, planted = graduations_in(data, found)

    if args.report:
        print(f"  seeded:    {describe(found)}")
        print(f"  graduates: {describe_graduates(graduations, planted)}")
        return 0

    if args.clear:
        removed = drop(data, found)
        if not removed:
            print("  nothing of this script's is in the store; it is untouched")
            return 0
        write_store(envelope, data)
        print(f"  removed {describe(found)}")
        clear_graduated_plants(planted, args.no_graduated_plant)
        report_liveness()
        return 0

    if any(found.values()):
        print(f"  already seeded: {describe(found)} — nothing changed")
        print(
            "  to rebuild it:  ./scripts/seed-tc-world --clear && ./scripts/seed-tc-world"
        )
        return 0

    library = check_strain_library()

    # Connected before anything is built, so an instance that cannot take the
    # graduate is refused while the store is still untouched.
    gm = None
    if not args.no_graduated_plant:
        gm = GrowspaceManager(HA_URL, read_token())
        gm.connect()

    repository = REPOSITORY.CultureRepository()
    repository.load(data)
    try:
        built = build(repository)
        graduate = (
            None if gm is None else cross_the_bridge(repository, gm, built, library)
        )
    except (COMMON.TcValidationError, COMMON.TcNotFoundError) as error:
        # The models' rejections carry a sentence written for the grower, and it
        # is the right thing to show: a refusal here means this script declared
        # a bench the shipped rules do not allow, and the rule says so itself.
        die(f"TC refused a record this script built: {error}")
    write_store(envelope, repository.as_dict())

    due = repository.due_replates()
    overdue = [entry for entry in due if entry[2] < EPOCH.isoformat()]
    locations = sorted(
        {
            vessel.location
            for vessels in built.vessels.values()
            for vessel in vessels
            if vessel.location
        }
    )

    vessels = sum(len(held) for held in built.vessels.values())
    oldest = max(act.days_ago for act in HISTORY)
    media = (
        "1 culture medium"
        if len(built.media) == 1
        else f"{len(built.media)} culture media"
    )
    print(f"  media:     {media} over {plural(built.versions, 'medium version')}")
    print(
        f"  lines:     {plural(len(built.lines), 'culture line')},"
        " one of them a Missing Phenotype"
    )
    print(
        f"  cultures:  {plural(vessels, 'vessel')}"
        f" across {plural(len(locations), 'location')}"
    )
    print(
        f"  history:   {plural(built.actions, 'maintenance action')},"
        f" the oldest {oldest} days back"
    )
    print(f"  pairings:  {plural(built.pairings, 'pairing')}")
    print(f"  graduates: {report_bridge(graduate)}")
    print(
        f"  worklist:  {plural(len(overdue), 'vessel')} overdue,"
        f" {plural(len(due) - len(overdue), 'vessel')} still on time"
    )
    for line, culture, at in overdue:
        name = line.phenotype.name_snapshot
        print(f"    due {at[:10]}   {name:<28} {culture.location}")
    report_liveness()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
