# --------------------------------------------------------------------------
# the lines
#
# A Phenotype Reference is Growspace Manager's key for a phenotype —
# "<strain>|<phenotype>", the string the card's own client-side join indexes on
# — and six of these name phenotypes the Demo Tent's plants are grown from, so
# the bench and the tent read as one grow.
#
# The seventh names a phenotype that is not in the library and never will be.
# A Missing Phenotype is the one TC state that cannot appear without being
# constructed on purpose: it is what a grower sees after deleting a strain
# Growspace Manager's side, and the whole point of the display-name snapshot
# (TC ADR-0006).
# --------------------------------------------------------------------------
@dataclass(frozen=True)
class Line:
    """One Culture Line and the Introduction that started it."""

    key: str
    phenotype_id: str
    phenotype_name: str
    multiplication: int
    rooting: int
    introduced_days_ago: int
    plantlet_count: int
    location: str
    resolves: bool = True


LINES: tuple[Line, ...] = (
