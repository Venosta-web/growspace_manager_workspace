# --------------------------------------------------------------------------
# the history
#
# Ninety days of acts, applied oldest first. A vessel is named by its index in
# its own line's creation order, because that is the only handle that exists
# before the repository has minted an ID for it.
# --------------------------------------------------------------------------
@dataclass(frozen=True)
class Planting:
    """Where a Graduation's bridge puts the plant it creates in Growspace Manager.

    Only the destination is declared. The genetics are the line's own, resolved
    through Growspace Manager's strain library the way the card's graduation
    form resolves them — TC never decodes its opaque phenotype reference, and
    neither does this.
    """

    growspace: str
    row: int
    col: int


@dataclass(frozen=True)
class Act:
    """One Maintenance Action against one vessel of one line."""

    days_ago: int
    line: str
    vessel: int
    kind: str
    note: str = ""
    medium: str = ""
    reason: str = ""
    # Replate only. Each entry is (plantlet count, location); a `None` location
    # means "wherever it already was", which is what the model reads it as.
    vessels: tuple[tuple[int | None, str | None], ...] = ()
    # Graduation only: the plant the bridge creates in Growspace Manager and
    # links back onto this act. `None` records the graduation TC's error path
    # writes when that call fails — an ending with nothing on the other side.
    plant: Planting | None = None


