# --- Home Assistant runtime state (never commit: contains tokens & secrets) ---
ha-dev/.storage/
ha-dev/.cloud/
ha-dev/deps/
ha-dev/tts/
ha-dev/*.db
ha-dev/*.db-*
ha-dev/*.log
ha-dev/*.log.*
ha-dev/.HA_VERSION
ha-dev/.uuid
ha-dev/.ha_run.lock
ha-dev/.cache/
ha-dev/secrets.yaml
ha-dev/blueprints/
# NOTE: ha-dev/packages/ is generated but TRACKED — see scripts/gen-e2e-sensors
ha-dev/image/
ha-dev/www/community/
ha-dev/custom_components/

ha-test/.storage/
ha-test/.cloud/
ha-test/deps/
ha-test/tts/
ha-test/*.db
ha-test/*.db-*
ha-test/*.log
ha-test/*.log.*
ha-test/.HA_VERSION
ha-test/.uuid
ha-test/.ha_run.lock
ha-test/.cache/
ha-test/secrets.yaml
ha-test/blueprints/
ha-test/image/
ha-test/www/
ha-test/custom_components/

# --- local credentials ---
.ha-token

# --- agent worktrees (they are real checkouts, not workspace content) ---
worktrees/

# --- editor / os ---
.vscode/
*.code-workspace.bak
.DS_Store

# Share the Codex environment for this multi-repo hub, but keep any other
# machine-local Codex state out of git.
.codex/*
!.codex/environments/
.codex/environments/*
!.codex/environments/environment.toml
